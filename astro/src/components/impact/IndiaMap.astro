    height: auto;
    display: block;
  }

  .site circle {
    stroke-width: 2;
  }

  .site--active circle {
    fill: var(--color-gold, #EEBE5A);
    stroke: #775F2D;
  }

  .site--upcoming circle {
    fill: #FFFDFB;
    stroke: #8C756D;
    stroke-dasharray: 3 2;
  }

  .site--previous circle {
    fill: #C9B8A8;
    stroke: #8C756D;
  }

  .site-label {
    font-family: var(--font-heading, sans-serif);
    font-size: 15px;
    font-weight: 700;
    fill: var(--color-text, #382213);
    paint-order: stroke;
    stroke: #FFF8F1;
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .site-sub {
    font-family: var(--font-body, sans-serif);
    font-size: 12.5px;
    font-weight: 500;
    fill: #4A3A30;
    paint-order: stroke;
    stroke: #FFF8F1;
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .india-map-legend {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 12px;
    font-family: var(--font-body, sans-serif);
    font-size: 13.5px;
    color: var(--color-text-mid, #5B4D43);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }

  .legend-dot--active {
    background: var(--color-gold, #EEBE5A);
    border: 2px solid #775F2D;
  }

  .legend-dot--upcoming {
    background: #FFFDFB;
    border: 2px dashed #8C756D;
  }

  .legend-dot--previous {
    background: #C9B8A8;
    border: 2px solid #8C756D;
  }
</style>
