---
// TeamHero.astro — Hero banner for Meet the Team page
// Per Phase 2 notes: header "Meet the Team", volunteer-led subtext,
// no pills (back button, leadership badge, stats).
---

<section class="team-hero">
  <div class="team-hero-inner">
    <h1 class="team-hero-title">Meet the Team</h1>
    <p class="team-hero-lead">
      Rosie&rsquo;s Heroes is led entirely by volunteers who believe every dog
      deserves love and safety. Meet the board members and volunteers turning
      that belief into action, and the dogs who hold a special place in their hearts.
    </p>
  </div>
</section>

<style>
  .team-hero {
    background: linear-gradient(180deg, #FFF8F1 0%, #FFEFDA 100%);
    padding: 70px 20px 54px;
    border-bottom: 1px solid #FFEDD6;
    text-align: center;
  }

  .team-hero-inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .team-hero-title {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(38px, 6vw, 56px);
    color: var(--color-text, #382213);
    line-height: var(--lh-tight, 1.1);
    letter-spacing: var(--ls-hero, -0.03em);
    margin: 0 0 18px;
  }

  .team-hero-lead {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(16px, 2.5vw, 19px);
    line-height: 1.6;
    color: var(--color-text-mid, #5B4D43);
    margin: 0;
    max-width: 700px;
  }
</style>
