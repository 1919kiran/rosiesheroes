---
import type { TeamMember } from '../../data/team';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<div class="flip-card-wrapper" id={member.id}>
  <div class="flip-card" role="region" aria-label={`Card for ${member.dogName} and ${member.fullName}`}>
    
    <!-- FRONT SIDE: Dog-led / Meet [Dog] -->
    <div class="card-side card-front">
      <!-- Top banner: Clean, no flip hint text -->
      <div class="side-badge-row">
        <span class="dog-badge">🐾 {member.dogTitle}</span>
      </div>

      <!-- Dog Avatar / Portrait -->
      <div class="dog-avatar-container">
        <div class="dog-circle" style={`background-color: ${member.dogAvatarColor};`}>
          <span class="dog-emoji-large">{member.dogEmoji}</span>
          <span class="dog-paw-badge">🐾</span>
        </div>
        <h3 class="dog-name">{member.dogName}</h3>
        <span class="dog-subtext">The Inspiration</span>
      </div>

      <!-- Dog Story -->
      <div class="story-container">
        <p class="dog-quote">"{member.dogStory}"</p>
      </div>

      <!-- Flip action button at bottom -->
      <button class="flip-btn" type="button" aria-label={`View ${member.dogName}'s companion ${member.name}`}>
        <span>View {member.dogName}'s Companion {member.name}</span>
      </button>
    </div>

    <!-- BACK SIDE: Human Companion & Board Leadership -->
    <div class="card-side card-back">
      <!-- Top banner -->
      <div class="side-badge-row">
        <span class="human-badge">Board Leadership</span>
      </div>

      <!-- Human Avatar / Portrait -->
      <div class="human-avatar-container">
        <div class="human-circle" style={`background-color: ${member.avatarColor};`}>
          <span class="human-initial">{member.initials}</span>
          <span class="human-star-badge">★</span>
        </div>
        <h3 class="human-name">{member.fullName}</h3>
        <span class="human-role">{member.role} · Board of Directors</span>
        <span class="human-career">{member.professionalRole}</span>
      </div>

      <!-- Human Leadership Bio -->
      <div class="story-container">
        <div class="bio-label-pill">Background & Leadership</div>
        <p class="human-bio-text">{member.bio}</p>
      </div>

      <!-- Flip back button at bottom -->
      <button class="flip-btn flip-btn--back" type="button" aria-label={`View Inspiration: ${member.dogName}`}>
        <span>View Inspiration: {member.dogName}</span>
      </button>
    </div>

  </div>
</div>

<style>
  .flip-card-wrapper {
    perspective: 1200px;
    height: 720px;
  }

  .flip-card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.4, 0.2, 0.2, 1);
    cursor: pointer;
  }

  .flip-card.is-flipped {
    transform: rotateY(180deg);
  }

  /* Card Faces */
  .card-side {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 20px;
    border: 1.5px solid var(--color-card-border, #FFEDD6);
    box-shadow: 0 6px 20px rgba(56, 34, 19, 0.06);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px 20px;
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
    box-sizing: border-box;
  }

  .card-side:hover {
    box-shadow: 0 10px 28px rgba(56, 34, 19, 0.1);
    border-color: #E6C8A4;
  }

  /* Front styling (Dog-led) */
  .card-front {
    background: linear-gradient(180deg, #FFFDFB 0%, #FFF8EE 100%);
  }

  /* Back styling (Human companion) */
  .card-back {
    background: linear-gradient(180deg, #FFFDFB 0%, #FBF4EA 100%);
    transform: rotateY(180deg);
  }

  /* Header badges row */
  .side-badge-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    margin-bottom: 12px;
  }

  .dog-badge {
    background: #FFEDD6;
    color: #8C5517;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 4px 14px;
    border-radius: 100px;
  }

  .human-badge {
    background: #EAE3D9;
    color: #382213;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 4px 14px;
    border-radius: 100px;
  }

  /* Avatar Area */
  .dog-avatar-container, .human-avatar-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 12px;
    min-height: 180px;
    justify-content: flex-start;
  }

  .dog-circle {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    border: 4px solid #FFFFFF;
    margin-bottom: 8px;
  }

  .dog-emoji-large {
    font-size: 44px;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
  }

  .dog-paw-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    background: #382213;
    color: #EEBE5A;
    font-size: 12px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #FFFFFF;
  }

  .dog-name {
    font-family: var(--font-heading, sans-serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text, #382213);
    margin: 0;
  }

  .dog-subtext {
    font-size: 13px;
    color: #8C5517;
    font-weight: 600;
    font-style: italic;
  }

  .human-circle {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    border: 4px solid #FFFFFF;
    color: #FFFFFF;
    margin-bottom: 8px;
  }

  .human-initial {
    font-family: var(--font-heading, sans-serif);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .human-star-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    background: #382213;
    color: #EEBE5A;
    font-size: 11px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #FFFFFF;
  }

  .human-name {
    font-family: var(--font-heading, sans-serif);
    font-size: 21px;
    font-weight: 700;
    color: var(--color-text, #382213);
    margin: 0;
  }

  .human-role {
    font-size: 13px;
    color: #5B4D43;
    font-weight: 700;
    margin-top: 2px;
  }

  .human-career {
    font-size: 11.5px;
    color: #8C5517;
    font-weight: 600;
    margin-top: 2px;
    max-width: 260px;
    line-height: 1.35;
  }

  /* Story / Bio container */
  .story-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background: #FFFDFB;
    border: 1px solid #FFEDD6;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
    overflow: visible;
  }

  .dog-quote {
    font-size: 14.5px;
    line-height: 1.6;
    color: #4C3C32;
    font-style: italic;
    margin: 0;
  }

  .bio-label-pill {
    display: inline-block;
    align-self: flex-start;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #382213;
    background: #FFEFDA;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .human-bio-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-text-mid, #5B4D43);
    margin: 0;
  }

  /* Flip button */
  .flip-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #FFF2E0;
    border: 1px solid #E6C8A4;
    color: #382213;
    padding: 12px 14px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: -0.01em;
  }

  .flip-btn span {
    white-space: nowrap;
  }

  .flip-btn:hover {
    background-color: var(--color-gold, #EEBE5A);
    border-color: #D9A842;
  }

  .flip-btn--back {
    background-color: #EFE8DE;
    border-color: #D4C7B8;
  }

  .flip-btn--back:hover {
    background-color: #382213;
    color: #FFF8F1;
    border-color: #382213;
  }

  .flip-icon {
    font-size: 15px;
    font-weight: bold;
  }
</style>

<script>
  document.querySelectorAll('.flip-card').forEach((card) => {
    card.addEventListener('click', (e) => {
      card.classList.toggle('is-flipped');
    });
  });
</script>
