---
// TeamMemberCard.astro — Founding Pack editorial row, per the team page mock.
// Portrait (person with dog photo, or placeholder) + dog line on one side,
// name / role / bio / "Why Rosie's Heroes" on the other. Alternates sides.
import type { FoundingPackMember } from '../../data/team';

interface Props {
  member: FoundingPackMember;
  index: number;
}

const { member, index } = Astro.props;
const reverse = index % 2 === 1;

// Inline style for the member photo: optional focal point + optional inset
// (inset shrinks the photo inside its frame = CSS-only zoom-out, no re-upload)
const photoStyle = [
  member.photoPosition ? `object-position: ${member.photoPosition}` : '',
  member.photoInset
    ? `padding: ${member.photoInset}; background-color: #FFEDD6; box-sizing: border-box`
    : '',
]
  .filter(Boolean)
  .join('; ');
---

<article class:list={['pack-row', { reverse }]}>
  <figure class="pack-portrait">
    <div class="pack-photo-wrap">
      {member.photo ? (
        <img
          class="pack-photo"
          src={member.photo}
          alt={`${member.fullName} with ${member.dogName}`}
          loading="lazy"
          width="480"
          height="360"
          style={photoStyle || undefined}
        />
      ) : (
        <div class="pack-photo pack-photo--placeholder" role="img" aria-label={`Placeholder for ${member.fullName} with ${member.dogName}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 5v2M12 17v2M5 12h2M17 12h2"/></svg>
        </div>
      )}
      <svg class="pack-paw-decor pack-paw-decor--tl" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
      <svg class="pack-paw-decor pack-paw-decor--br" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
    </div>
    <figcaption class="pack-dogline">
      <svg class="pack-dogline-paw" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
      <span>
        <strong>{member.dogName}</strong>
        <span class="pack-dog-fact-label">Fun fact</span>
        <span class="pack-dog-fact-text">{member.dogFunFact}</span>
      </span>
    </figcaption>
  </figure>

  <div class="pack-text">
    <h3 class="pack-name">{member.fullName}</h3>
    <div class="pack-role">{member.role}</div>
    <p class="pack-bio">{member.bio}</p>
    <div class="pack-why">
      <h4>Why Rosie&rsquo;s Heroes</h4>
      <p>{member.whyRosiesHeroes}</p>
    </div>
  </div>
</article>

<style>
  .pack-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
    padding: 46px 0;
    border-bottom: 1px solid #fde9cc;
  }

  .pack-row:last-child {
    border-bottom: none;
  }

  .pack-row.reverse .pack-portrait {
    order: 2;
  }

  .pack-portrait {
    margin: 0;
    min-width: 0;
  }

  /* Tilted photo frame with paw-print decor */
  .pack-photo-wrap {
    position: relative;
    transform: rotate(-1.6deg);
    transition: transform 0.3s ease;
  }

  .pack-row.reverse .pack-photo-wrap {
    transform: rotate(1.6deg);
  }

  .pack-photo-wrap:hover {
    transform: rotate(0deg);
  }

  .pack-paw-decor {
    position: absolute;
    width: 44px;
    height: 44px;
    color: var(--color-gold, #EEBE5A);
    opacity: 0.9;
    pointer-events: none;
    z-index: 2;
  }

  .pack-paw-decor--tl {
    top: -18px;
    left: -14px;
    transform: rotate(-18deg);
  }

  .pack-paw-decor--br {
    bottom: -16px;
    right: -12px;
    transform: rotate(14deg);
  }

  .pack-photo {
    height: 360px;
    width: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
    border: 3px solid #ffedd6;
    border-radius: 18px;
    box-shadow: 0 10px 28px rgba(56, 34, 19, 0.10);
  }

  .pack-photo--placeholder {
    background: #ffefda;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    color: #8c756d;
  }

  .pack-photo--placeholder svg {
    width: 85px;
    height: 85px;
    opacity: 0.6;
  }

  .pack-photo--placeholder svg:last-child {
    width: 60px;
    height: 60px;
    margin-top: 45px;
  }

  .pack-dogline {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 4px 0;
    font-family: var(--font-body, sans-serif);
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-mid, #5B4D43);
  }

  .pack-dogline-paw {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    color: var(--color-gold, #EEBE5A);
    margin-top: 2px;
  }

  .pack-dogline strong {
    font-family: var(--font-heading, sans-serif);
    font-size: 17px;
    color: var(--color-text, #382213);
    margin-right: 10px;
  }

  .pack-dog-fact-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold-hover, #775F2D);
    margin-right: 8px;
  }

  .pack-dog-fact-text {
    display: block;
    margin-top: 4px;
  }

  .pack-name {
    font-family: var(--font-heading, sans-serif);
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: -0.7px;
    color: var(--color-text, #382213);
    margin: 0 0 12px;
  }

  .pack-role {
    font-family: var(--font-heading, sans-serif);
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #624b40;
    margin-bottom: 20px;
  }

  .pack-bio {
    font-family: var(--font-body, sans-serif);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-mid, #5B4D43);
    margin: 0 0 20px;
  }

  .pack-why {
    border-top: 2px solid #eebe5a;
    padding-top: 17px;
    margin-top: 22px;
  }

  .pack-why h4 {
    font-family: var(--font-heading, sans-serif);
    font-size: 19px;
    color: var(--color-text, #382213);
    margin: 0 0 10px;
  }

  .pack-why p {
    font-family: var(--font-body, sans-serif);
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-mid, #5B4D43);
    margin: 0;
  }

  @media (max-width: 860px) {
    .pack-row {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 36px 0;
    }

    .pack-row.reverse .pack-portrait {
      order: 0;
    }

    .pack-photo {
      height: 300px;
    }
  }
</style>
