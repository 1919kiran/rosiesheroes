---
// Donate section
// Background: var(--color-cream-donate) = #FFF5EA
// Donation tiers laid out as a table-style card list
// Cards use: border: 3px solid var(--color-card-border), border-radius: 0px
// Tier amounts in bold left column, tier name + description in right column

import {
  zeffyModalUrl,
  zeffyEmbedUrl,
  zeffyThermometerUrl,
  mainCampaignSlug,
  campaigns,
} from '../../data/donate';
---

<section id="donate">

  <svg class="donate-bg donate-bg--tl" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
  <svg class="donate-bg donate-bg--bl" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
  <svg class="donate-bg donate-bg--rm" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>

  <div class="section-inner">

    <!-- Section header -->
    <div class="donate-header" data-reveal>
      <h2 class="donate-title">
        Be the Hero the World Needs
        <svg class="paw-decor paw-heading" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="currentColor">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </h2>
      <p class="donate-meta">Rosie’s Broken to Brave Heroes is a 501(c)(3) nonprofit animal rescue with EIN 38-4382498. Donations are tax-deductible and 100% of donations are used towards animal rescue.</p>
    </div>

    <!-- Ways to give -->
    <div class="donate-cards" id="donate-cards" data-reveal>
      <div class="donate-card">
        <span class="donate-card-badge">Preferred</span>
        <div class="donate-card-top">
          <h3 class="donate-card-title">Zeffy</h3>
          <p class="donate-card-sub">Card or digital wallet. Your tax receipt is emailed instantly.</p>
        </div>
        <figure class="donate-card-qr">
          <img src="/images/zeffy.png" alt="Scan to donate via Zeffy" width="180" height="180" loading="lazy" />
          <figcaption class="donate-card-hint">Scan with your phone camera</figcaption>
        </figure>
        <button type="button" class="donate-card-btn" zeffy-form-link={zeffyModalUrl(mainCampaignSlug)}>Donate</button>
      </div>

      <div class="donate-card">
        <div class="donate-card-top">
          <h3 class="donate-card-title">Zelle</h3>
          <p class="donate-card-sub">Zero fees — 100% goes to the dogs</p>
        </div>
        <figure class="donate-card-qr">
          <img src="/images/zelle.png" alt="Scan to donate via Zelle" width="180" height="180" loading="lazy" />
          <figcaption class="donate-card-hint">Scan with your banking app</figcaption>
        </figure>
        <p class="donate-card-send">Send to <strong>rosiesheroes</strong></p>
      </div>

      <div class="donate-card">
        <div class="donate-card-top">
          <h3 class="donate-card-title">PayPal</h3>
          <p class="donate-card-sub">Credit card, debit, or Venmo accepted</p>
        </div>
        <button type="button" class="donate-card-btn" id="paypal-form-toggle">Donate</button>
        <div class="paypal-form-panel" id="paypal-form-panel">
          <div id="paypal-container-LJ6RFXLPK2ML8"></div>
        </div>
      </div>

      <div class="donate-card">
        <div class="donate-card-top">
          <h3 class="donate-card-title">Stock, crypto &amp; DAF</h3>
          <p class="donate-card-sub">Give stock, cryptocurrency, or from a donor-advised fund</p>
        </div>
        <button type="button" class="donate-card-btn" id="every-donate-btn">Donate</button>
      </div>
    </div>

    <!-- Employer matching -->
    <div class="donate-match" data-reveal>
      <h3 class="donate-match-title"><span aria-hidden="true">💚</span> Your Gift Could Go Twice as Far</h3>
      <p>Your kindness could help even more dogs get the care they deserve. Many employers match charitable donations, which means your gift to Rosie’s Heroes could provide twice the lifesaving impact—at no extra cost to you.</p>
      <p><strong>Already donated?</strong> You may still be able to request a match. Check with your employer to help your generosity go further, funding critical trauma care and spay/neuter for dogs who need us most.</p>
    </div>

    <!-- Campaigns: live thermometer + embedded Zeffy form -->
    <div class="donate-campaigns-header" data-reveal>
      <h3 class="donate-subheading">Help Bring These Projects to Life</h3>
      <p class="donate-subheading-text">Support a project close to your heart and give more dogs a chance at safety and healing.</p>
    </div>
    <div class="donate-campaigns">
      {campaigns.map((c) => (
        <article class="donate-campaign" data-reveal="card">
          <h4 class="donate-campaign-title">{c.title}</h4>
          <div style="position:relative;overflow:hidden;width:100%;padding-top:120px;"><iframe title='Donation form powered by Zeffy' style='position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:120px' src={zeffyThermometerUrl(c.slug)} allowtransparency="true"></iframe></div>
          <iframe
            class="donate-campaign-form"
            title={`Donate to ${c.title} (powered by Zeffy)`}
            src={zeffyEmbedUrl(c.slug)}
            loading="lazy"
            allow="payment"
            allowtransparency="true"
          ></iframe>
        </article>
      ))}
    </div>

    <!-- Donation tiers -->
    <h3 class="donate-subheading donate-tiers-heading" data-reveal>The Power of your Action</h3>
    <div class="donate-tiers">

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$25</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Ally:</span>
          <p class="donate-tier-desc">One complete spay/neuter + rabies vaccine, breaking the transmission chain for one dog.</p>
          <p class="donate-tier-recognition">Recognition: Digital thank you.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$100</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Defender:</span>
          <p class="donate-tier-desc">Sterilizes and vaccinates 4 dogs, creating a protective barrier in a community.</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus mention on our social media.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$500</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Advocate:</span>
          <p class="donate-tier-desc">Protects a small village by vaccinating all at-risk dogs (approx. 20-25 animals).</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus a virtual meet-and-greet with a field team member.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$2,500</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Champion:</span>
          <p class="donate-tier-desc">Help bring a transformative project to life—like a rescue ambulance or covered shelter—building lasting infrastructure that empowers communities to help hundreds of dogs per year.</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus a named sponsorship of a campaign.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$10,000</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Hero:</span>
          <p class="donate-tier-desc">Supports a full mobile clinic for a month, reaching remote areas and saving hundreds of lives.</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus named feature in our annual report.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$25,000+</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Legend:</span>
          <p class="donate-tier-desc">Transforms a region, funding sustained programs for a year, moving towards rabies-free status.</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus recognition on major initiatives and invitation to a field visit.</p>
        </div>
      </div>

    </div><!-- /.donate-tiers -->

  </div><!-- /.section-inner -->
</section>

<script is:inline>
  (function() {
    function loadScript(src, onload) {
      var s = document.createElement('script');
      s.src = src;
      s.onload = onload;
      document.head.appendChild(s);
    }

    var paypalState = 'idle';
    var everyState = 'idle';
    var everyPendingOpen = false;

    function loadPaypal() {
      if (paypalState !== 'idle') return;
      paypalState = 'loading';
      loadScript('https://www.paypal.com/sdk/js?client-id=BAAn2t0F7jpy6SyZ6NZV4VBR3axQFaZX7pnIhgWueptAPfDzy5Wp750lQP9fX41qXyhOaBmoayL130eB-U&components=hosted-buttons&disable-funding=venmo&currency=USD', function() {
        paypalState = 'ready';
        paypal.HostedButtons({
          hostedButtonId: "LJ6RFXLPK2ML8",
        }).render("#paypal-container-LJ6RFXLPK2ML8");
      });
    }

    function openEvery() {
      everyDotOrgDonateButton.setOptions({
        nonprofitSlug: 'rosies-broken-to-brave-heroes',
        methods: ['stocks', 'crypto', 'daf'],
        // Default anchor is "donate", which would auto-open the widget on /#donate
        openAt: 'every-org-donate',
        primaryColor: '#775F2D',
      });
      everyDotOrgDonateButton.showWidget();
    }

    function loadEvery() {
      if (everyState !== 'idle') return;
      everyState = 'loading';
      loadScript('https://embeds.every.org/0.4/button.js?explicit=1', function() {
        everyState = 'ready';
        if (everyPendingOpen) openEvery();
      });
    }

    var cards = document.getElementById('donate-cards');
    if (cards && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        if (entries.some(function(e) { return e.isIntersecting; })) {
          io.disconnect();
          loadPaypal();
          loadEvery();
        }
      }, { rootMargin: '300px 0px' });
      io.observe(cards);
    }

    var paypalBtn = document.getElementById('paypal-form-toggle');
    var paypalPanel = document.getElementById('paypal-form-panel');
    if (paypalBtn && paypalPanel) {
      paypalBtn.addEventListener('click', function() {
        loadPaypal();
        var isOpen = paypalPanel.classList.toggle('open');
        paypalBtn.classList.toggle('active', isOpen);
      });
    }

    var everyBtn = document.getElementById('every-donate-btn');
    if (everyBtn) {
      everyBtn.addEventListener('click', function() {
        if (everyState === 'ready') {
          openEvery();
        } else {
          everyPendingOpen = true;
          loadEvery();
        }
      });
    }
  })();
</script>

<style>
  /* --------------------------------------------------------
     DONATE SECTION
     -------------------------------------------------------- */
  #donate {
    background-color: var(--color-cream-donate); /* #FFF5EA */
    padding: var(--space-25) 0 var(--space-20);
    position: relative;
  }

  .section-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  /* ── Section header ─────────────────────────────────────── */
  .donate-header {
    margin-bottom: var(--space-10); /* 40px */
  }

  .donate-title {
    font-family: var(--font-heading);
    font-size: var(--text-section); /* 38px */
    font-weight: 600;
    line-height: 1.3em;
    letter-spacing: var(--ls-tight);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .paw-heading {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--color-gold);
    vertical-align: middle;
  }

  .donate-meta {
    font-family: var(--font-body);
    font-size: var(--text-base); /* 16px */
    line-height: var(--lh-normal);
    color: var(--color-text);
    margin: 0;
  }

  /* ── Tiers list ─────────────────────────────────────────── */
  .donate-tiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .donate-tier {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: stretch;
    gap: var(--space-5);
    padding: var(--space-3) 0;
  }

  /* ── Amount column — bordered card, progressively wider ── */
  .donate-tier-amount {
    font-family: var(--font-heading);
    font-size: var(--text-lg); /* 18px */
    font-weight: 600;
    line-height: 1;
    color: var(--color-text);
    white-space: nowrap;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-card-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .donate-tier:nth-child(1) .donate-tier-amount { min-width: 110px; }
  .donate-tier:nth-child(2) .donate-tier-amount { min-width: 130px; }
  .donate-tier:nth-child(3) .donate-tier-amount { min-width: 150px; }
  .donate-tier:nth-child(4) .donate-tier-amount { min-width: 170px; }
  .donate-tier:nth-child(5) .donate-tier-amount { min-width: 190px; }
  .donate-tier:nth-child(6) .donate-tier-amount { min-width: 210px; }

  /* ── Content column ─────────────────────────────────────── */
  .donate-tier-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .donate-tier-name {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-base); /* 16px */
    font-weight: 600;
    color: var(--color-gold); /* #EEBE5A */
  }

  .donate-tier-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm); /* 15px */
    line-height: var(--lh-normal);
    color: var(--color-text);
    margin: 0;
  }

  .donate-tier-recognition {
    font-family: var(--font-body);
    font-size: var(--text-xs); /* 14px */
    line-height: var(--lh-normal);
    color: var(--color-text-mid);
    margin: 0;
  }

  /* ── Ways-to-give cards ─────────────────────────────────── */
  .donate-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .donate-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 10px;
    padding: var(--space-6);
  }

  /* Shadow instead of a thicker border keeps the QR codes level across the row */
  .donate-card:first-child {
    border-color: var(--color-gold);
    box-shadow: 0 0 0 1px var(--color-gold);
  }

  .donate-card-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-gold);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .donate-card-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .donate-card-sub {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }

  .donate-card-qr {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .donate-card-qr img {
    display: block;
    width: 180px;
    height: 180px;
    padding: var(--space-2);
    background: #fff;
    border: 1px solid var(--color-card-border);
    border-radius: 6px;
  }

  .donate-card-hint {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .donate-card-send {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    margin: 0;
  }

  .donate-card-send strong {
    color: var(--color-gold-hover);
  }

  .donate-card-btn {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-gold);
    margin: 0;
    padding: 6px 32px;
    border: 1.5px solid var(--color-gold);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .donate-card-btn:hover,
  .donate-card-btn.active {
    background: var(--color-gold);
    color: var(--color-text);
  }

  .paypal-form-panel {
    display: none;
    width: 100%;
    animation: fadeSlideIn 0.3s ease;
  }

  .paypal-form-panel.open {
    display: block;
  }

  #paypal-container-LJ6RFXLPK2ML8 {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Employer matching ──────────────────────────────────── */
  .donate-match {
    margin-top: var(--space-5);
    padding: var(--space-5) var(--space-6);
    background: var(--color-card-bg);
    border-left: 3px solid var(--color-gold);
    border-radius: 6px;
  }

  .donate-match-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--lh-snug);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  .donate-match-title span { margin-right: var(--space-1); }

  .donate-match p {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--lh-normal);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  .donate-match p:last-child { margin-bottom: 0; }

  /* ── Campaigns ──────────────────────────────────────────── */
  .donate-campaigns-header {
    margin-top: var(--space-15);
    margin-bottom: var(--space-5);
  }

  .donate-subheading {
    font-family: var(--font-heading);
    font-size: var(--text-card); /* 24px */
    font-weight: 600;
    line-height: var(--lh-snug);
