---
// Donate section
// Background: var(--color-cream-donate) = #FFF5EA
// Donation tiers laid out as a table-style card list
// Cards use: border: 3px solid var(--color-card-border), border-radius: 0px
// Tier amounts in bold left column, tier name + description in right column
---

<section id="donate">

  <svg class="donate-bg donate-bg--tl" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
  <svg class="donate-bg donate-bg--bl" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
  <svg class="donate-bg donate-bg--rm" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>

  <div class="section-inner">

    <!-- Section header -->
    <div class="donate-header" data-reveal>
      <h2 class="donate-title">
        Donate
        <svg class="paw-decor paw-heading" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="currentColor">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </h2>
      <p class="donate-subtitle">Be the Hero the World Needs.</p>
      <p class="donate-meta">Rosie's Heroes is a 501c3 animal rescue (tax number 38-4382498).</p>
    </div>

    <!-- Donate methods -->
    <div class="donate-cards" data-reveal>
      <div class="donate-card">
        <span class="donate-card-badge">Preferred</span>
        <div class="donate-card-top">
          <h3 class="donate-card-title">Zelle</h3>
          <p class="donate-card-sub">Zero fees — 100% goes to the dogs</p>
        </div>
        <div class="donate-card-action">
          <p class="donate-card-label">Send to</p>
          <button class="donate-card-id" id="zelle-qr-toggle" type="button">rosiesheroes</button>
          <p class="donate-card-tap-hint">Tap to show QR code</p>
        </div>
        <div class="zelle-qr-panel" id="zelle-qr-panel">
          <img src="/images/zelle.png" alt="Scan to donate via Zelle" class="donate-card-qr-large" width="280" height="280" loading="lazy" />
          <p class="donate-card-scan-hint">Scan with your banking app</p>
        </div>
      </div>
      <div class="donate-card">
        <div class="donate-card-top">
          <h3 class="donate-card-title">PayPal</h3>
          <p class="donate-card-sub">Credit card, debit, or Venmo accepted</p>
        </div>
        <div class="donate-card-action">
          <button class="donate-card-id" id="paypal-form-toggle" type="button">Donate Now</button>
          <p class="donate-card-tap-hint">Tap to open donation form</p>
        </div>
        <div class="paypal-form-panel" id="paypal-form-panel">
          <div id="paypal-container-LJ6RFXLPK2ML8"></div>
        </div>
      </div>
    </div>

    <!-- Donation tiers -->
    <div class="donate-tiers">

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$25</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Ally:</span>
          <p class="donate-tier-desc">One complete spay/neuter + rabies vaccine, breaking the transmission chain for one dog.</p>
          <p class="donate-tier-recognition">Recognition: Digital thank you.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$100</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Defender:</span>
          <p class="donate-tier-desc">Sterilizes and vaccinates 4 dogs, creating a protective barrier in a community.</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus mention on our social media.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$500</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Advocate:</span>
          <p class="donate-tier-desc">Protects a small village by vaccinating all at-risk dogs (approx. 20-25 animals).</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus a virtual meet-and-greet with a field team member.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$2,500</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Champion:</span>
          <p class="donate-tier-desc">Funds a full sterilization and vaccination campaign day for 100+ dogs, preventing dozens of potential rabies cases.</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus a named sponsorship of a campaign.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$10,000</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Hero:</span>
          <p class="donate-tier-desc">Supports a full mobile clinic for a month, reaching remote areas and saving hundreds of lives.</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus named feature in our annual report.</p>
        </div>
      </div>

      <div class="donate-tier" data-reveal="card">
        <div class="donate-tier-amount">$25,000+</div>
        <div class="donate-tier-content">
          <span class="donate-tier-name">Legend:</span>
          <p class="donate-tier-desc">Transforms a region, funding sustained programs for a year, moving towards rabies-free status.</p>
          <p class="donate-tier-recognition">Recognition: All previous, plus recognition on major initiatives and invitation to a field visit.</p>
        </div>
      </div>

    </div><!-- /.donate-tiers -->

  </div><!-- /.section-inner -->
</section>

<script is:inline src="https://www.paypal.com/sdk/js?client-id=BAAn2t0F7jpy6SyZ6NZV4VBR3axQFaZX7pnIhgWueptAPfDzy5Wp750lQP9fX41qXyhOaBmoayL130eB-U&components=hosted-buttons&disable-funding=venmo&currency=USD"></script>
<script is:inline>
  if (typeof paypal !== 'undefined') {
    paypal.HostedButtons({
      hostedButtonId: "LJ6RFXLPK2ML8",
    }).render("#paypal-container-LJ6RFXLPK2ML8");
  }
</script>

<script is:inline>
  (function() {
    function setupToggle(btnId, panelId) {
      var btn = document.getElementById(btnId);
      var panel = document.getElementById(panelId);
      if (btn && panel) {
        btn.addEventListener('click', function() {
          var isOpen = panel.classList.toggle('open');
          btn.classList.toggle('active', isOpen);
        });
      }
    }
    setupToggle('zelle-qr-toggle', 'zelle-qr-panel');
    setupToggle('paypal-form-toggle', 'paypal-form-panel');
  })();
</script>

<style>
  /* --------------------------------------------------------
     DONATE SECTION
     -------------------------------------------------------- */
  #donate {
    background-color: var(--color-cream-donate); /* #FFF5EA */
    padding: var(--space-25) 0 var(--space-20);
    position: relative;
  }

  .section-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  /* ── Section header ─────────────────────────────────────── */
  .donate-header {
    margin-bottom: var(--space-10); /* 40px */
  }

  .donate-title {
    font-family: var(--font-heading);
    font-size: var(--text-section); /* 38px */
    font-weight: 600;
    line-height: 1.3em;
    letter-spacing: var(--ls-tight);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .paw-heading {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--color-gold);
    vertical-align: middle;
  }

  .donate-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-base); /* 16px */
    line-height: var(--lh-normal);
    color: var(--color-text);
    margin: 0;
  }

  .donate-meta {
    font-family: var(--font-body);
    font-size: var(--text-base); /* 16px */
    line-height: var(--lh-normal);
    color: var(--color-text);
    margin: 0;
  }

  /* ── Tiers list ─────────────────────────────────────────── */
  .donate-tiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .donate-tier {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: stretch;
    gap: var(--space-5);
    padding: var(--space-3) 0;
  }

  /* ── Amount column — bordered card, progressively wider ── */
  .donate-tier-amount {
    font-family: var(--font-heading);
    font-size: var(--text-lg); /* 18px */
    font-weight: 600;
    line-height: 1;
    color: var(--color-text);
    white-space: nowrap;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-card-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .donate-tier:nth-child(1) .donate-tier-amount { min-width: 110px; }
  .donate-tier:nth-child(2) .donate-tier-amount { min-width: 130px; }
  .donate-tier:nth-child(3) .donate-tier-amount { min-width: 150px; }
  .donate-tier:nth-child(4) .donate-tier-amount { min-width: 170px; }
  .donate-tier:nth-child(5) .donate-tier-amount { min-width: 190px; }
  .donate-tier:nth-child(6) .donate-tier-amount { min-width: 210px; }

  /* ── Content column ─────────────────────────────────────── */
  .donate-tier-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .donate-tier-name {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-base); /* 16px */
    font-weight: 600;
    color: var(--color-gold); /* #EEBE5A */
  }

  .donate-tier-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm); /* 15px */
    line-height: var(--lh-normal);
    color: var(--color-text);
    margin: 0;
  }

  .donate-tier-recognition {
    font-family: var(--font-body);
    font-size: var(--text-xs); /* 14px */
    line-height: var(--lh-normal);
    color: var(--color-text-mid);
    margin: 0;
  }

  /* ── Donate method cards ──────────────────────────────────── */
  .donate-cards {
    margin-top: var(--space-10);
    margin-bottom: var(--space-15);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .donate-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 10px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    position: relative;
  }

  .donate-card-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-gold);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .donate-card-top { text-align: center; }

  .donate-card-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .donate-card-sub {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }

  .donate-card-action { text-align: center; }

  .donate-card-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0 0 4px;
  }

  .donate-card-id {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-gold);
    margin: 0;
    padding: 6px 24px;
    border: 1.5px solid var(--color-gold);
    border-radius: var(--radius-pill);
    display: inline-block;
    background: transparent;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .donate-card-id:hover {
    background: var(--color-gold);
    color: var(--color-text);
  }

  .donate-card-tap-hint {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    margin: 6px 0 0;
  }

  .zelle-qr-panel,
  .paypal-form-panel {
    display: none;
    text-align: center;
    animation: fadeSlideIn 0.3s ease;
  }

  .zelle-qr-panel.open,
  .paypal-form-panel.open {
    display: block;
  }

  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .donate-card-qr-large {
    border-radius: 10px;
    border: 1px solid var(--color-card-border);
  }

  .donate-card-scan-hint {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: var(--space-2) 0 0;
  }

  .donate-card-btn {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-gold);
    border: 2px solid var(--color-gold);
    border-radius: var(--radius-pill);
    padding: 6px 28px;
    text-decoration: none;
    transition: var(--trans-btn);
  }

  .donate-card-btn:hover {
    background: var(--color-gold-hover);
    border-color: var(--color-gold-hover);
    color: var(--color-gold-dark-hover);
  }

  #paypal-container-LJ6RFXLPK2ML8 {
    width: 100%;
    min-width: 340px;
  }

  .paypal-form-panel {
    width: 100%;
  }

  .donate-card-qr {
    border-radius: 6px;
    border: 1px solid var(--color-card-border);
    opacity: 0.85;
  }

  .donate-card-id.active {
    background: var(--color-gold);
    color: var(--color-text);
  }

  /* ── Reveal animations ──────────────────────────────────── */
  [data-reveal]:not([data-reveal="card"]) {
    opacity: 0;
    transform: translateY(22px);
    transition: var(--trans-reveal);
  }

  [data-reveal]:not([data-reveal="card"]).visible {
    opacity: 1;
    transform: none;
  }

  [data-reveal="card"] {
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transition: var(--trans-card);
  }

  [data-reveal="card"].visible {
    opacity: 1;
    transform: none;
  }

  .donate-bg { position: absolute; pointer-events: none; color: #E8C278; opacity: 0.15; }
  .donate-bg--tl { width: 220px; height: 220px; top: 5%; left: 2%; transform: rotate(-22deg); }
  .donate-bg--bl { width: 180px; height: 180px; bottom: 6%; left: 2%; transform: rotate(-18deg); }
  .donate-bg--rm { width: 190px; height: 190px; top: 40%; right: 2%; transform: rotate(28deg); }

  /* ── Mobile responsive ─────────────────────────────────── */
  @media (max-width: 768px) {
    .donate-bg { display: none; }

    #donate {
      padding: var(--space-15) 0 var(--space-10);
    }

    .donate-title {
      font-size: 28px;
    }

    .donate-tiers {
      gap: var(--space-3);
    }

    .donate-tier {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding: var(--space-4);
      border-radius: 8px;
      background-color: #fff;
      border: 1px solid var(--color-card-border);
      border-left: 4px solid var(--color-gold);
    }

    .donate-tier-amount {
      min-width: 0 !important;
      font-size: var(--text-lg);
      padding: var(--space-1) 0;
      border: none;
      background: none;
      justify-content: flex-start;
      color: var(--color-gold);
    }

    .donate-tier-name {
      font-size: var(--text-sm);
      display: inline;
    }

    .donate-tier-desc {
      font-size: var(--text-xs);
      display: inline;
    }

    .donate-tier-recognition {
      font-size: var(--text-2xs);
    }

    .donate-tier:nth-child(1) { border-left-width: 3px; }
    .donate-tier:nth-child(2) { border-left-width: 4px; }
    .donate-tier:nth-child(3) { border-left-width: 5px; }
    .donate-tier:nth-child(4) { border-left-width: 6px; }
    .donate-tier:nth-child(5) { border-left-width: 7px; }
    .donate-tier:nth-child(6) { border-left-width: 8px; }

    .donate-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
