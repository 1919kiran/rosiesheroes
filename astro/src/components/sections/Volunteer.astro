---
// Volunteer section
// Background: var(--color-dark-brown) = #382213 — DARK section
// Text color: var(--color-text-on-dark) = #FFF8F1
// Two info cards with var(--color-vol-card-bg) = #FFEFDA, border-radius: 50px
// CTA "Flight Hero" dark card uses var(--color-dark-cta) = #624B40
---

<section id="volunteer">

  <!-- Decorative background: paw prints on right -->
  <svg class="vol-bg vol-bg--paw1" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <g>
      <path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"></path>
      <path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"></path>
      <path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"></path>
      <path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"></path>
      <path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"></path>
    </g>
  </svg>
  <svg class="vol-bg vol-bg--paw2" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <g>
      <path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"></path>
      <path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"></path>
      <path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"></path>
      <path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"></path>
      <path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"></path>
    </g>
  </svg>

  <div class="section-inner">

    <!-- Section header -->
    <div class="vol-header" data-reveal>
      <h2 class="vol-title">Volunteer</h2>
      <p class="vol-intro">
        There are so many ways to help dogs &mdash; near and far. Whether you can
        give an hour a week or a weekend a month, your time and talents can save lives.
      </p>
    </div>

    <!-- Ways to volunteer card -->
    <div class="vol-cards">

      <div class="vol-card vol-card--full" data-reveal="card">
        <h3 class="vol-card-title">Ways to Volunteer</h3>
        <ul class="vol-card-list vol-card-list--cols">
          <li><strong>Social media</strong> &mdash; help share stories that find dogs homes</li>
          <li><strong>Grant writing</strong> &mdash; unlock funding for lifesaving programs</li>
          <li><strong>Fundraising</strong> &mdash; turn compassion into resources</li>
          <li><strong>Events</strong> &mdash; help plan and run community gatherings</li>
          <li><strong>Flight volunteering</strong> &mdash; escort a rescue dog on your India&ndash;US trip <a href="https://docs.google.com/document/d/1_OjKA_pXFduS6fT6bHTM847Z_ZacQ8TkX3lHj5gquv4/edit?tab=t.0#heading=h.x6nrrfeybvnj" target="_blank" rel="noreferrer noopener" class="vol-inline-link">(FAQs)</a></li>
          <li><strong>And more</strong> &mdash; tell us your skills and we&rsquo;ll find a fit</li>
        </ul>
      </div>

    </div><!-- /.vol-cards -->

    <!-- Volunteer CTA card -->
    <div class="vol-cta-card" data-reveal="card">
      <div class="vol-cta-text">
        <h3 class="vol-cta-title">Ready to Lend a Paw?</h3>
        <p class="vol-cta-desc">Tell us how you&rsquo;d like to help &mdash; social media, fundraising, events, grant writing, flight volunteering, or something else entirely. <a href="#contact" class="vol-cta-link">Contact us</a> today and we&rsquo;ll find the perfect fit!</p>
        <div class="vol-cta-buttons">
          <a href="#contact" class="btn btn-primary">Volunteer</a>
        </div>
      </div>
    </div><!-- /.vol-cta-card -->

  </div><!-- /.section-inner -->

</section>


<style>
  /* --------------------------------------------------------
     VOLUNTEER SECTION — dark background
     -------------------------------------------------------- */
  #volunteer {
    background-color: var(--color-dark-brown); /* #382213 */
    padding: var(--space-25) 0 var(--space-20);
    position: relative;
    overflow: visible;
  }

  /* ── Background decorative elements ──────────────────────── */
  .vol-bg {
    position: absolute;
    pointer-events: none;
  }

  /* Paw prints — right side */
  .vol-bg--paw1 {
    width: 220px;
    height: 220px;
    top: 38%;
    right: 2%;
    color: #6B4A35;
    opacity: 0.40;
    transform: rotate(10deg);
  }

  .vol-bg--paw2 {
    width: 150px;
    height: 150px;
    bottom: 12%;
    left: 3%;
    color: #6B4A35;
    opacity: 0.35;
    transform: rotate(-15deg);
  }


  .section-inner {
    max-width: var(--site-width); /* 980px */
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  /* ── Section header ─────────────────────────────────────── */
  .vol-header {
    text-align: center;
    margin-bottom: var(--space-12); /* 48px */
  }

  .vol-title {
    font-family: var(--font-heading);
    font-size: var(--text-section); /* 38px */
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--color-text-warm); /* #FFEFDA */
    margin: 0 0 var(--space-6);
  }

  .vol-intro {
    font-family: var(--font-body);
    font-size: var(--text-lg); /* 18px */
    line-height: var(--lh-relaxed);
    color: var(--color-text-on-dark); /* #FFF8F1 */
    max-width: 680px;
    margin: 0 auto;
  }

  /* ── Ways to volunteer card ─────────────────────────────── */
  .vol-cards {
    display: grid;
    grid-template-columns: 1fr;
    margin-bottom: var(--space-8); /* 32px */
  }

  .vol-card {
    background-color: var(--color-vol-card-bg); /* #FFEFDA */
    border-radius: var(--radius-vol-card); /* 50px */
    padding: var(--space-10) var(--space-10); /* 40px */
    box-shadow: var(--shadow-vol);
  }

  .vol-card--full {
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
  }

  .vol-card-title {
    font-family: var(--font-heading);
    font-size: var(--text-label); /* 20px */
    font-weight: 600;
    line-height: var(--lh-snug);
    color: var(--color-text); /* #382213 */
    margin: 0 0 var(--space-6);
  }

  .vol-card-title--gold {
    color: var(--color-gold); /* #EEBE5A */
  }

  /* ── Ways to volunteer list ─────────────────────────────── */
  .vol-card-list {
    font-family: var(--font-body);
    font-size: var(--text-base); /* 16px */
    line-height: var(--lh-relaxed);
    color: var(--color-text);
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3); /* 12px */
  }

  .vol-card-list--cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3) var(--space-8);
  }

  .vol-card-list li {
    line-height: 1.5em;
    padding-left: var(--space-6);
    position: relative;
  }

  .vol-card-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
  }

  /* ── Volunteer CTA card ─────────────────────────────────── */
  .vol-cta-card {
    background-color: var(--color-dark-cta); /* #624B40 */
    border-radius: var(--radius-vol-card); /* 50px */
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-10) var(--space-12);
    overflow: hidden;
  }

  .vol-cta-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .vol-cta-title {
    font-family: var(--font-heading);
    font-size: var(--text-section); /* 38px */
    font-weight: 600;
    line-height: var(--lh-snug);
    color: var(--color-text-warm); /* #FFEFDA */
    margin: 0;
    text-align: center;
    letter-spacing: var(--ls-tight);
  }

  .vol-cta-desc {
    font-family: var(--font-body);
    font-size: var(--text-base); /* 16px */
    line-height: 1.3em;
    color: var(--color-text-warm);
    margin: 0;
    text-align: center;
  }

  .vol-cta-link {
    color: var(--color-text-warm);
    text-decoration: none;
    font-weight: 600;
  }

  .vol-cta-link:hover {
    color: var(--color-gold);
    text-decoration: underline;
  }

  /* Inline FAQs link next to the flight-volunteer bullet */
  .vol-inline-link {
    color: var(--color-gold);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  .vol-inline-link:hover {
    text-decoration: underline;
  }

  /* ── CTA buttons ────────────────────────────────────────── */
  .vol-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 var(--space-8);
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--trans-btn);
    border: 2px solid transparent;
  }

  .btn-primary {
    background-color: var(--color-gold);
    color: var(--color-text);
    border-color: var(--color-gold);
  }

  .btn-primary:hover {
    background-color: var(--color-gold-hover);
    border-color: var(--color-gold-hover);
    color: var(--color-gold-dark-hover);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-text-warm);
    border-color: var(--color-text-warm);
  }

  .btn-secondary:hover {
    background-color: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-text);
  }

  /* ── Illustration ───────────────────────────────────────── */
  .vol-cta-illus {
    flex-shrink: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .vol-cta-illus img {
    width: 260px;
    height: auto;
    display: block;
    object-fit: contain;
    /* nudge down slightly so illustration appears to sit on the card */
    margin-bottom: calc(-1 * var(--space-10));
  }

  /* ── Reveal animations ──────────────────────────────────── */
  [data-reveal]:not([data-reveal="card"]) {
    opacity: 0;
    transform: translateY(22px);
    transition: var(--trans-reveal);
  }

  [data-reveal]:not([data-reveal="card"]).visible {
    opacity: 1;
    transform: none;
  }

  [data-reveal="card"] {
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transition: var(--trans-card);
  }

  [data-reveal="card"].visible {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 768px) {
    #volunteer {
      padding: var(--space-12) 0 var(--space-10);
    }

    .vol-title {
      font-size: 28px;
    }

    .vol-card {
      padding: var(--space-6);
      border-radius: 24px;
    }

    .vol-card-list--cols {
      grid-template-columns: 1fr;
    }

    .vol-cta-card {
      grid-template-columns: 1fr;
      padding: var(--space-6) var(--space-6);
      border-radius: 24px;
    }

    .vol-cta-title {
      font-size: 24px;
    }

    .vol-bg--paw1 {
      width: 130px;
      height: 130px;
      opacity: 0.18;
    }

    .vol-bg--paw2 {
      width: 90px;
      height: 90px;
      opacity: 0.15;
    }
  }
</style>
