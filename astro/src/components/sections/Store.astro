---
// Store section — "Shop to Support"
// Background: var(--color-cream) = #FFF8F1 (same as Happy Tails, which follows)
// Links out to the Rosie's Heroes Store on Zeffy. Shopping is framed as impact:
// every purchase funds trauma care, spay & neuter, and rescue for street dogs in India.
const storeUrl = 'https://www.zeffy.com/en-US/ticketing/rosies-heroes-store';
---

<section id="store">

  <svg class="store-bg store-bg--tl" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
  <svg class="store-bg store-bg--br" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>

  <div class="section-inner">

    <!-- Section header -->
    <div class="store-header" data-reveal>
      <p class="store-eyebrow"><span aria-hidden="true">🐾</span> Shop to Support</p>
      <h2 class="store-title">
        Every Purchase Helps a Dog Heal
        <svg class="paw-heading" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="currentColor">
          <g>
            <path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z"></path>
            <path d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"></path>
            <path d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"></path>
            <path d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"></path>
            <path d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"></path>
          </g>
        </svg>
      </h2>
      <p class="store-lead">Every purchase from our little store funds trauma care surgeries, spay &amp; neuter, and rescue for street dogs in India — so a little shopping does a lot of healing.</p>
    </div>

    <!-- What you'll find -->
    <div class="store-tiles" data-reveal>
      <div class="store-tile">
        <span class="store-tile-icon" aria-hidden="true">👗</span>
        <h3 class="store-tile-title">Dressed to Impress</h3>
        <p>Brocade dresses and sherwanis that turn every pup into the best-dressed guest — from $40.</p>
      </div>
      <div class="store-tile">
        <span class="store-tile-icon" aria-hidden="true">👕</span>
        <h3 class="store-tile-title">For the Humans</h3>
        <p>Our maroon polo and navy zipper hoodie let you wear the mission wherever you go.</p>
      </div>
      <div class="store-tile">
        <span class="store-tile-icon" aria-hidden="true">💚</span>
        <h3 class="store-tile-title">Every Purchase = Impact</h3>
        <p>Each order helps fund trauma care surgery, spay &amp; neuter, and rescue for street dogs in India.</p>
      </div>
    </div>

    <!-- Favorites with prices -->
    <div class="store-chips" data-reveal>
      <span class="store-chip">Pink Brocade Dog Dress <strong>$40</strong></span>
      <span class="store-chip">Teal Brocade Dog Sherwani <strong>$40</strong></span>
      <span class="store-chip">Tie-Dye Dog Dress <strong>$55</strong></span>
      <span class="store-chip">Maroon Polo <strong>$35</strong></span>
      <span class="store-chip">Navy Zipper Hoodie <strong>$50</strong></span>
    </div>

    <!-- CTA -->
    <div class="store-cta" data-reveal>
      <a class="btn btn-primary" href={storeUrl} target="_blank" rel="noopener">Visit the Store <span aria-hidden="true">🐾</span></a>
      <p class="store-note">Hosted on Zeffy, so more of every purchase goes straight to the dogs.</p>
    </div>

  </div>

</section>

<style>
  #store {
    background-color: var(--color-cream); /* #FFF8F1 */
    padding: var(--space-15) 0;
    position: relative;
    overflow: hidden;
  }

  .store-bg { position: absolute; pointer-events: none; color: #E8C278; opacity: 0.15; }
  .store-bg--tl { width: 220px; height: 220px; top: 5%; left: 2%; transform: rotate(-22deg); }
  .store-bg--br { width: 190px; height: 190px; bottom: 6%; right: 2%; transform: rotate(28deg); }

  .store-header {
    text-align: center;
    margin-bottom: var(--space-10); /* 40px */
  }

  .store-eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-hover); /* #775F2D */
    margin-bottom: var(--space-3);
  }

  .store-title {
    font-family: var(--font-heading);
    font-size: var(--text-section); /* 38px */
    font-weight: 600;
    line-height: 1.3em;
    letter-spacing: var(--ls-tight);
    color: var(--color-text);
  }

  .store-title .paw-heading {
    width: 34px;
    height: 34px;
    color: var(--color-gold);
    display: inline-block;
    vertical-align: -4px;
    margin-left: 6px;
  }

  .store-lead {
    max-width: 640px;
    margin: var(--space-4) auto 0;
    font-size: var(--text-lg);
    line-height: var(--lh-relaxed);
    color: var(--color-text-mid);
  }

  .store-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .store-tile {
    background-color: var(--color-card-bg);
    border: 3px solid var(--color-card-border);
    border-radius: var(--radius-card); /* 0px — square, matches site cards */
    padding: var(--space-8) var(--space-6);
    text-align: center;
  }

  .store-tile-icon {
    display: block;
    font-size: 34px;
    margin-bottom: var(--space-3);
  }

  .store-tile-title {
    font-family: var(--font-heading);
    font-size: var(--text-card); /* 24px */
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .store-tile p {
    font-size: var(--text-sm);
    line-height: var(--lh-relaxed);
    color: var(--color-text-mid);
  }

  .store-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
  }

  .store-chip {
    background-color: var(--color-card-bg);
    border: 2px solid var(--color-card-border);
    border-radius: var(--radius-pill);
    padding: 6px 16px;
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    white-space: nowrap;
  }

  .store-chip strong {
    color: var(--color-text);
  }

  .store-cta {
    text-align: center;
  }

  .store-note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ── Mobile responsive ─────────────────────────────────── */
  @media (max-width: 768px) {
    .store-bg { display: none; }

    #store {
      padding: var(--space-10) 0;
    }

    .store-title {
      font-size: 28px;
    }

    .store-tiles {
      grid-template-columns: 1fr;
    }
  }
</style>
