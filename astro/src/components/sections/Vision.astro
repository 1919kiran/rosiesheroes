---
// Vision section — "Broken to Brave"
import BrokenToBrave from '../ui/BrokenToBrave.astro';
---

<section id="vision">
  <div class="section-inner vision-inner">

    <!-- Section label — centered -->
    <h2 class="vision-label" data-reveal="fade" style="text-align:center;width:100%;">Vision</h2>

    <!-- Body text -->
    <p class="vision-body" data-reveal="fade">
      Rosie's Heroes is not just focused on individual rescue but on reducing suffering at scale for dogs and people.
      We believe that dogs and people deserve to live in a compassionate world where every neighborhood is safe and
      animals are treated humanely. We partner locally to sterilize and vaccinate dogs at scale, reducing bite
      incidents, lowering public health costs, and stabilizing communities.
    </p>

    <!-- Broken to Brave card — full content width -->
    <BrokenToBrave />

  </div>


  <!-- Dog + tennis ball illustrations -->
  <img
    id="vision-labrador"
    src="/images/broken_to_brave.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
  />

</section>

<style>
  #vision {
    background-color: var(--color-cream-vision);
    padding: var(--space-8) 0 var(--space-10);
    position: relative;
    overflow: visible;
  }

  .vision-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* ---- Section heading — centered ---- */
  .vision-label {
    font-family: var(--font-heading);
    font-size: var(--text-section); /* 38px */
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: var(--ls-snug);
    line-height: var(--lh-tight);
    text-align: center;
  }

  /* ---- Body paragraph ---- */
  .vision-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  /* ---- Airplane parallax ----
     Positioned at bottom of section; JS will animate transform.
     Starts off-screen right; uses section-relative t in main.js.  */
  #airplane {
    position: absolute;
    left: calc(50% + 390px);
    bottom: 180px;
    width: 209px;
    height: 127px;
    pointer-events: none;
    will-change: transform;
    z-index: 2;
    opacity: 0; /* hidden by default; JS controls opacity */
  }

  /* ---- Labrador + tennis ball illustrations ---- */
  #vision-labrador {
    position: absolute;
    bottom: 0;
    left: 30px;
    width: 300px;
    height: auto;
    pointer-events: none;
    z-index: 2;
  }

  #vision-tennis-ball {
    position: absolute;
    bottom: 5px;
    left: 20px;
    width: 40px;
    height: auto;
    pointer-events: none;
    z-index: 3;
  }

  @media (max-width: 900px) {
    #vision-labrador,
    #vision-tennis-ball,
    #airplane {
      display: none;
    }
  }

  @media (max-width: 768px) {
    #vision {
      padding: var(--space-6) 0 var(--space-8);
    }

    .vision-label {
      font-size: 28px;
    }

    .vision-body {
      font-size: 15px;
    }

    .vision-inner {
      gap: var(--space-5);
    }
  }
</style>
