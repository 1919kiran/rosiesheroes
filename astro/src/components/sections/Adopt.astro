---
// Adopt section
// Background: var(--color-cream-adopt) = #FFF5EA
// Layout: centered header, centered body text, then card with left text + right photo
// Puppy-lying illustration is a parallax element positioned absolutely
---

<section id="adopt">

  <svg class="adopt-bg adopt-bg--tl" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
  <svg class="adopt-bg adopt-bg--br" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>

  <div class="section-inner">

    <!-- Section header -->
    <div class="adopt-header" data-reveal>
      <h2 class="adopt-title">
        Adopt
        <svg class="adopt-title-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </h2>
    </div>

    <!-- Centered intro text -->
    <p class="adopt-intro" data-reveal>
      Your adoption creates impact at home and beyond. Part of your adoption fee provides urgent medical care for local dogs in need. The rest supports large-scale spay and vaccination efforts in high-rabies regions, preventing suffering before it begins. When one dog finds a home, entire communities move closer to safety.
    </p>

    <!-- Card: steps + photo -->
    <div class="adopt-card" data-reveal="card">

      <!-- LEFT: steps + CTA buttons -->
      <div class="adopt-card-left">
        <h3 class="adopt-card-title">Ready to start your adoption journey?</h3>

        <div class="adopt-steps">
          <div class="adopt-step">
            <span class="adopt-step-label">Apply</span>
            <p class="adopt-step-desc">Tell us about your home and lifestyle.</p>
          </div>
          <div class="adopt-step">
            <span class="adopt-step-label">Meet</span>
            <p class="adopt-step-desc">Video call + meet the dog through our foster network</p>
          </div>
          <div class="adopt-step">
            <span class="adopt-step-label">Adopt</span>
            <p class="adopt-step-desc">Sign, pay the adoption fee, and start your life together!</p>
          </div>
        </div>

        <div class="adopt-cta">
          <a href="#contact" class="btn btn-primary">Apply</a>
          <a href="/meet-the-dogs" class="btn btn-secondary">Meet The Dogs</a>
        </div>
      </div>

      <!-- RIGHT: golden retriever photo -->
      <div class="adopt-card-photo" aria-hidden="true">
        <img
          src="/images/adopt.jpg"
          width="380"
          height="360"
        />
      </div>

    </div><!-- /.adopt-card -->

  </div><!-- /.section-inner -->
</section>

<style>
  /* --------------------------------------------------------
     ADOPT SECTION
     -------------------------------------------------------- */
  #adopt {
    background-color: var(--color-dark-brown); /* #382213 */
    padding: var(--space-20) 0 var(--space-20);
    position: relative;
    overflow: visible;
  }

  .section-inner {
    max-width: var(--site-width); /* 980px */
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  /* ── Parallax puppy ─────────────────────────────────────── */
  #puppy-lying {
    position: absolute;
    left: -20px;
    bottom: 120px;
    width: 160px;
    height: auto;
    pointer-events: none;
    will-change: transform;
    z-index: 2;
  }

  /* ── Section header ─────────────────────────────────────── */
  .adopt-header {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .adopt-title {
    font-family: var(--font-heading);
    font-size: var(--text-section); /* 38px */
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--color-text-warm); /* #FFEFDA */
    margin: 0 0 var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .adopt-title-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .adopt-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-base); /* 16px */
    font-weight: 400;
    color: var(--color-gold);
    margin: 0;
  }

  /* ── Centered intro body text ───────────────────────────── */
  .adopt-intro {
    font-family: var(--font-body);
    font-size: var(--text-base); /* 16px */
    line-height: var(--lh-relaxed);
    color: var(--color-text-on-dark); /* #FFF8F1 */
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-12); /* 48px below */
  }

  /* ── Adoption card ──────────────────────────────────────── */
  .adopt-card {
    background-color: #FFEFDA;
    border: 1px solid var(--color-card-border);
    border-radius: 8px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: stretch;
    overflow: hidden;
  }

  /* ── Card left column ───────────────────────────────────── */
  .adopt-card-left {
    padding: var(--space-8) var(--space-10);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-5);
  }

  .adopt-card-title {
    font-family: var(--font-heading);
    font-size: 25px;
    font-weight: 600;
    line-height: var(--lh-snug);
    color: var(--color-text);
    margin: 0;
  }

  /* ── Steps list ─────────────────────────────────────────── */
  .adopt-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-5); /* 20px between steps */
  }

  .adopt-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .adopt-step-label {
    font-family: var(--font-heading);
    font-size: var(--text-sm); /* 15px — approx 17px in source */
    font-weight: 600;
    color: var(--color-gold);
    line-height: var(--lh-snug);
  }

  .adopt-step-desc {
    font-family: var(--font-body);
    font-size: var(--text-base); /* 16px */
    line-height: var(--lh-relaxed);
    color: var(--color-text);
    margin: 0;
  }

  /* ── CTA buttons ────────────────────────────────────────── */
  .adopt-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  /* Shared button base (matches site button styles) */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 var(--space-8);
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--trans-btn);
    border: 2px solid transparent;
  }

  .btn-primary {
    background-color: var(--color-gold);
    color: var(--color-text);
    border-color: var(--color-gold);
  }

  .btn-primary:hover {
    background-color: var(--color-gold-hover);
    border-color: var(--color-gold-hover);
    color: var(--color-gold-dark-hover);
  }

  .btn-secondary {
    background-color: var(--color-outline-bg);
    color: var(--color-text);
    border-color: var(--color-card-border);
  }

  .btn-secondary:hover {
    background-color: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-text);
  }

  /* ── Card right column: photo ───────────────────────────── */
  .adopt-card-photo {
    width: 340px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .adopt-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  /* ── Reveal animations ──────────────────────────────────── */
  [data-reveal]:not([data-reveal="card"]) {
    opacity: 0;
    transform: translateY(22px);
    transition: var(--trans-reveal);
  }

  [data-reveal]:not([data-reveal="card"]).visible {
    opacity: 1;
    transform: none;
  }

  [data-reveal="card"] {
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transition: var(--trans-card);
  }

  [data-reveal="card"].visible {
    opacity: 1;
    transform: none;
  }

  .adopt-bg { position: absolute; pointer-events: none; color: #6B4A35; opacity: 0.4; }
  .adopt-bg--tl { width: 210px; height: 210px; top: 6%; left: 2%; transform: rotate(-18deg); }
  .adopt-bg--br { width: 190px; height: 190px; bottom: 8%; right: 2%; transform: rotate(22deg); }

  @media (max-width: 768px) {
    .adopt-bg { display: none; }

    #adopt {
      padding: var(--space-6) 0 var(--space-10);
    }

    .adopt-heading {
      font-size: 28px;
    }

    .adopt-card {
      grid-template-columns: 1fr;
    }

    .adopt-card-photo {
      width: 100%;
      height: 300px;
    }

    .adopt-card-photo img {
      object-position: center 30%;
    }

    #puppy-lying,
    #ball-tennis {
      display: none;
    }

    .adopt-cta {
      flex-wrap: nowrap;
    }

    .adopt-cta .btn {
      flex: 1;
      padding: 0 var(--space-4);
      font-size: var(--text-sm);
    }
  }
</style>
