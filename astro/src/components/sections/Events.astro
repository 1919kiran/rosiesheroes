---
// Events section — Google Calendar embed + upcoming events list.
// The calendar is the public "Rosie's Heroes Events" Google Calendar
// (rosiesheroes@gmail.com). Events with no confirmed date can't live on
// Google Calendar, so they appear in the upcoming list with their month
// window only. Add or edit events in src/data/events.ts.
import { events } from '../../data/events';

const CALENDAR_EMBED =
  'https://calendar.google.com/calendar/embed?src=bfdb73cf1f2fe1d705d7ae0db617d1a36546c629a8219215c40a7363314ee0dc%40group.calendar.google.com&ctz=America%2FLos_Angeles';

function fmtMonthYear(iso: string) {
  return new Date(iso + 'T00:00:00').toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
  });
}

const items = events.map((ev) => ({
  ...ev,
  monthYear: ev.date ? fmtMonthYear(ev.date) : ev.month,
}));
---

<section id="events">
  <svg class="events-paw-decor events-paw-decor--one" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
  <svg class="events-paw-decor events-paw-decor--two" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
  <svg class="events-paw-decor events-paw-decor--three" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
  <div class="section-inner">
    <div class="events-header" data-reveal>
      <svg class="events-paw-mark" viewBox="14.245 16.736 171.51 166.528" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g><path d="M98.902 88.05c-21.698 0-59.447 52.147-61.533 66.037-2.393 15.935 11.019 29.177 27.133 29.177 10.137 0 30.913-11.779 34.4-11.779 3.367 0 23.912 11.779 34.017 11.779 16.114 0 30.472-13.299 27.725-29.177-2.294-13.264-40.009-66.037-61.742-66.037z" fill="currentColor"/><path fill="currentColor" d="M91.411 45.161c0 15.699-8.055 28.425-17.991 28.425S55.429 60.86 55.429 45.161s8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M50.227 93.365c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425S22.3 64.94 32.236 64.94s17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M144.571 45.161c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/><path fill="currentColor" d="M185.755 89.042c0 15.699-8.055 28.425-17.991 28.425s-17.991-12.726-17.991-28.425 8.055-28.425 17.991-28.425 17.991 12.726 17.991 28.425z"/></g></svg>
      <h2 class="events-title">Upcoming Events</h2>
      <p class="events-intro">
        Browse the calendar below, or find an event in the list.
      </p>
    </div>

    <div class="events-embed" data-reveal="card">
      <iframe
        src={CALENDAR_EMBED}
        title="Rosie's Heroes events calendar"
        width="100%"
        height="600"
        frameborder="0"
        scrolling="no"
      ></iframe>
    </div>

    <div class="events-list">
      <h3 class="events-list-title">Upcoming Events</h3>
      <div class="events-table-head" aria-hidden="true">
        <span>Event</span>
        <span>Description</span>
        <span>Month / Year</span>
        <span>Location</span>
      </div>
      <ul class="events-simple-list">
        {
          items.map((ev) => (
            <li>
              <span class="simple-name">{ev.title}</span>
              <span class="simple-desc">{ev.blurb}</span>
              <span class="simple-month">{ev.monthYear}</span>
              <span class="simple-loc">{ev.location}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  #events {
    background-color: var(--color-cream-events);
    padding: 72px 0;
    position: relative;
    overflow: hidden;
  }
  #events .section-inner { position: relative; z-index: 1; }
  .events-paw-decor {
    position: absolute;
    color: var(--color-gold);
    opacity: 0.4;
    pointer-events: none;
    z-index: 0;
  }
  .events-paw-decor--one { width: 120px; top: 36px; right: 3%; transform: rotate(22deg); }
  .events-paw-decor--two { width: 88px; bottom: 48px; left: 2.5%; transform: rotate(-20deg); }
  .events-paw-decor--three { width: 64px; top: 46%; right: 6%; transform: rotate(-14deg); opacity: 0.3; }
  .events-paw-mark {
    display: block;
    width: 36px;
    margin: 0 auto 12px;
    color: var(--color-gold);
    transform: rotate(-12deg);
  }
  .events-header { text-align: center; margin-bottom: 32px; }
  .events-title { margin: 0 0 8px; }
  .events-intro { color: var(--color-text-mid); margin: 0; font-size: var(--text-lg); }
  .events-embed {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 24px;
    padding: 12px;
    overflow: hidden;
    margin-bottom: 32px;
  }
  .events-embed iframe {
    display: block;
    width: 100%;
    border: 0;
    border-radius: 16px;
  }
  .events-list {
    max-width: 1080px;
    margin: 0 auto;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 24px;
    padding: 28px 32px;
  }
  .events-list-title { margin: 0 0 20px; text-align: center; font-size: var(--text-card); }
  .events-table-head {
    display: grid;
    grid-template-columns: 1.3fr 2.2fr 1fr 1.3fr;
    gap: 20px;
    padding: 0 0 12px;
    border-bottom: 3px solid var(--color-gold);
    color: var(--color-dark-brown);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .events-simple-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .events-simple-list li {
    display: grid;
    grid-template-columns: 1.3fr 2.2fr 1fr 1.3fr;
    gap: 20px;
    align-items: baseline;
    padding: 18px 12px;
    margin: 0 -12px;
    border-bottom: 1px solid var(--color-card-border);
    border-radius: 12px;
  }
  .events-simple-list li:last-child { border-bottom: none; }
  .events-simple-list li:hover { background: var(--color-cream); }
  .simple-name { font-family: var(--font-heading); font-weight: 700; font-size: 20px; }
  .simple-desc { color: var(--color-text-mid); }
  .simple-month { color: var(--color-text-muted); font-size: 15px; }
  .simple-loc { color: var(--color-text-mid); font-size: 15px; }
  @media (max-width: 768px) {
    .events-paw-decor { display: none; }
    .events-table-head { display: none; }
    .events-list { padding: 20px; }
    .events-simple-list li { grid-template-columns: 1fr; gap: 2px; margin: 0; padding: 16px 0; }
    .events-simple-list li:hover { background: transparent; }
    .events-embed iframe { height: 500px; }
    #events { padding: 48px 0; }
  }
</style>
