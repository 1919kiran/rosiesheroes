---
// Events section — Google Calendar embed + upcoming events list.
// The calendar is the public "Rosie's Heroes Events" Google Calendar
// (rosiesheroes@gmail.com). Events with no confirmed date can't live on
// Google Calendar, so they appear in the upcoming list with their month
// window only. Add or edit events in src/data/events.ts.
import { events } from '../../data/events';

const CALENDAR_EMBED =
  'https://calendar.google.com/calendar/embed?src=bfdb73cf1f2fe1d705d7ae0db617d1a36546c629a8219215c40a7363314ee0dc%40group.calendar.google.com&ctz=America%2FLos_Angeles';

function fmtDate(iso: string) {
  return new Date(iso + 'T00:00:00').toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

const cards = events.map((ev) => ({
  ...ev,
  when: ev.date
    ? fmtDate(ev.date) + (ev.time ? ' · ' + ev.time : '')
    : (ev.dateLabel ?? 'Date to be announced'),
  rsvp:
    'mailto:rosiesheroes@gmail.com?subject=' +
    encodeURIComponent('RSVP: ' + ev.title) +
    '&body=' +
    encodeURIComponent(
      "Hi Rosie's Heroes,\n\nI'd like to RSVP for " +
        ev.title +
        (ev.date ? ' on ' + fmtDate(ev.date) : ev.dateLabel ? ' (' + ev.dateLabel + ')' : '') +
        '.\n\nName:\nNumber of guests:\n',
    ),
}));
---

<section id="events">
  <div class="section-inner">
    <div class="events-header" data-reveal>
      <h2 class="events-title">Upcoming Events</h2>
      <p class="events-intro">
        Browse the calendar below, or find an event in the list and RSVP by email.
      </p>
    </div>

    <div class="events-embed" data-reveal="card">
      <iframe
        src={CALENDAR_EMBED}
        title="Rosie's Heroes events calendar"
        width="100%"
        height="600"
        frameborder="0"
        scrolling="no"
      ></iframe>
    </div>

    <div class="events-list">
      {
        cards.map((ev) => (
          <article class="event-card" data-reveal="card">
            <span class="event-month">{ev.month}</span>
            <h3 class="event-title">{ev.title}</h3>
            <p class="event-blurb">{ev.blurb}</p>
            <p class="event-meta">
              {ev.when} · {ev.location}
            </p>
            {ev.note && <p class="event-note">{ev.note}</p>}
            <a class="btn btn-primary event-rsvp" href={ev.rsvp}>
              RSVP
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  #events {
    background-color: var(--color-cream-events);
    padding: 72px 0;
  }
  .events-header { text-align: center; margin-bottom: 32px; }
  .events-title { margin: 0 0 8px; }
  .events-intro { color: var(--color-text-mid); margin: 0; font-size: var(--text-lg); }
  .events-embed {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 24px;
    padding: 12px;
    overflow: hidden;
    margin-bottom: 32px;
  }
  .events-embed iframe {
    display: block;
    width: 100%;
    border: 0;
    border-radius: 16px;
  }
  .events-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .event-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 24px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .event-month {
    display: inline-block;
    background: var(--color-gold);
    color: var(--color-dark-brown);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 6px 14px;
    margin-bottom: 14px;
  }
  .event-title { margin: 0 0 8px; font-size: var(--text-card); }
  .event-blurb { margin: 0 0 12px; }
  .event-meta { margin: 0 0 4px; color: var(--color-text-mid); }
  .event-note { color: var(--color-text-muted); font-size: 15px; margin: 8px 0 0; }
  .event-card .event-rsvp { margin-top: 20px; }
  @media (max-width: 768px) {
    .events-list { grid-template-columns: 1fr; }
    .events-embed iframe { height: 500px; }
    #events { padding: 48px 0; }
  }
</style>
