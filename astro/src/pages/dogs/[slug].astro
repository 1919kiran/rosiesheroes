---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';
import MobileBottomNav from '../../components/layout/MobileBottomNav.astro';
import { dogs } from '../../data/dogs';
import type { Dog } from '../../data/dogs';

export function getStaticPaths() {
  return dogs.map(dog => ({
    params: { slug: dog.slug },
    props: { dog },
  }));
}

const { dog } = Astro.props as { dog: Dog };
---

<BaseLayout title={`${dog.name} | Rosie's Heroes`}>
  <Nav />
  <main class="dog-profile">
    <div class="profile-inner">

      <a href="/meet-the-dogs" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Back to all dogs
      </a>

      <div class="profile-grid">

        <div class="profile-text">
          <h1 class="dog-name">{dog.name} <span class="dog-emoji">{dog.emoji}</span></h1>
          <div class="dog-description">
            {dog.fullDesc.map(paragraph => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

        <div class="profile-sidebar">
          <div class="photo-frame" data-dog-carousel>
            <div class="dog-carousel-track">
              {dog.photos.map((photo, i) => (
                <img
                  src={photo}
                  alt={`${dog.name} photo ${i + 1}`}
                  class="dog-photo"
                  loading={i === 0 ? "eager" : "lazy"}
                />
              ))}
            </div>
            {dog.photos.length > 1 && (
              <>
                <button class="dog-carousel-btn dog-carousel-prev" aria-label="Previous photo">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button class="dog-carousel-btn dog-carousel-next" aria-label="Next photo">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </button>
                <div class="dog-carousel-dots">
                  {dog.photos.map((_, i) => (
                    <button class={`dog-carousel-dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Go to photo ${i + 1}`}></button>
                  ))}
                </div>
              </>
            )}
          </div>

          <div class="bio-card">
            <div class="bio-row">
              <span class="bio-label">Name</span>
              <span class="bio-value">{dog.name}</span>
            </div>
            {dog.gender && (
              <div class="bio-row">
                <span class="bio-label">Gender</span>
                <span class="bio-value">{dog.gender}</span>
              </div>
            )}
            <div class="bio-row">
              <span class="bio-label">Age</span>
              <span class="bio-value">{dog.age}</span>
            </div>
            <div class="bio-row">
              <span class="bio-label">Weight</span>
              <span class="bio-value">{dog.weight}</span>
            </div>
            <div class="bio-row">
              <span class="bio-label">Location</span>
              <span class="bio-value">{dog.location}</span>
            </div>
            <div class="bio-row">
              <span class="bio-label">Good with Dogs?</span>
              <span class="bio-value">{dog.goodWithDogs}</span>
            </div>
            <div class="bio-row">
              <span class="bio-label">Good with Cats?</span>
              <span class="bio-value">{dog.goodWithCats}</span>
            </div>
            {dog.crateTrained && (
              <div class="bio-row">
                <span class="bio-label">Crate Trained?</span>
                <span class="bio-value">{dog.crateTrained}</span>
              </div>
            )}
            {dog.quirks && (
              <div class="bio-row">
                <span class="bio-label">Quirks</span>
                <span class="bio-value">{dog.quirks}</span>
              </div>
            )}
            {dog.vaccinations && (
              <div class="bio-row">
                <span class="bio-label">Vaccinations</span>
                <span class="bio-value">{dog.vaccinations}</span>
              </div>
            )}
          </div>
        </div>

      </div>

      <div class="cta-section">
        <h2 class="cta-heading">Ready to meet {dog.name}?</h2>
        <a href="/#contact" class="cta-button">Apply to Adopt</a>
      </div>

    </div>
  </main>
  <Footer />
  <MobileBottomNav />
</BaseLayout>

<style>
  .dog-profile {
    background-color: var(--color-cream);
    min-height: 100vh;
    padding: var(--space-10) 0 var(--space-25);
  }

  .profile-inner {
    max-width: var(--site-width);
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  /* ── Back link ─────────────────────────────────────────── */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-8);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .back-link svg {
    flex-shrink: 0;
  }

  /* ── Two-column grid ───────────────────────────────────── */
  .profile-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-10);
    align-items: start;
  }

  /* ── Left column: name + description ───────────────────── */
  .dog-name {
    font-family: var(--font-heading);
    font-size: var(--text-section);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-tight);
    color: var(--color-text);
    margin: 0 0 var(--space-6);
  }

  .dog-emoji {
    font-size: 0.8em;
  }

  .dog-description p {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: var(--color-text-mid);
    margin: 0 0 var(--space-4);
  }

  .dog-description p:last-child {
    margin-bottom: 0;
  }

  /* ── Right column: photo + bio card ────────────────────── */
  .profile-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .photo-frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-card-bg);
  }

  .dog-carousel-track {
    display: flex;
    height: 100%;
    width: 100%;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .dog-photo {
    width: 100%;
    height: 100%;
    flex: 0 0 100%;
    object-fit: cover;
    display: block;
  }

  .dog-carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .dog-carousel-btn:hover {
    background: #fff;
  }

  .dog-carousel-btn svg {
    width: 18px;
    height: 18px;
  }

  .dog-carousel-prev { left: 10px; }
  .dog-carousel-next { right: 10px; }

  .dog-carousel-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 2;
  }

  .dog-carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .dog-carousel-dot:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  .dog-carousel-dot.active {
    background: #fff;
    transform: scale(1.25);
  }

  /* ── Bio data card ─────────────────────────────────────── */
  .bio-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    padding: var(--space-4) var(--space-5);
  }

  .bio-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) 0;
  }

  .bio-row + .bio-row {
    border-top: 1px solid var(--color-card-border);
  }

  .bio-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }

  .bio-value {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: var(--lh-normal);
  }

  /* ── CTA section ───────────────────────────────────────── */
  .cta-section {
    text-align: center;
    margin-top: var(--space-20);
    padding: var(--space-12) var(--space-5);
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
  }

  .cta-heading {
    font-family: var(--font-heading);
    font-size: var(--text-card);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-6);
  }

  .cta-button {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    background-color: var(--color-gold);
    border: 2px solid var(--color-gold);
    border-radius: var(--radius-pill);
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    transition: var(--trans-btn);
    cursor: pointer;
  }

  .cta-button:hover {
    background-color: var(--color-gold-hover);
    border-color: var(--color-gold-hover);
    color: var(--color-gold-dark-hover);
  }

  /* ── Mobile layout ─────────────────────────────────────── */
  @media (max-width: 768px) {
    .dog-profile {
      padding: var(--space-6) 0 var(--space-15);
    }

    .profile-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .profile-sidebar {
      order: -1;
    }

    .photo-frame {
      aspect-ratio: 4 / 3;
    }

    .dog-name {
      font-size: 28px;
    }

    .cta-section {
      margin-top: var(--space-12);
      padding: var(--space-8) var(--space-5);
    }

    .cta-heading {
      font-size: var(--text-label);
    }
  }
</style>

<script>
  document.querySelectorAll('[data-dog-carousel]').forEach(carousel => {
    const track = carousel.querySelector('.dog-carousel-track') as HTMLElement | null;
    const imgs = carousel.querySelectorAll('.dog-photo');
    const prevBtn = carousel.querySelector('.dog-carousel-prev');
    const nextBtn = carousel.querySelector('.dog-carousel-next');
    const dots = carousel.querySelectorAll('.dog-carousel-dot');
    if (!track || imgs.length <= 1) return;

    let current = 0;

    function goTo(i: number) {
      current = (i + imgs.length) % imgs.length;
      track!.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, idx) => d.classList.toggle('active', idx === current));
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
  });
</script>
