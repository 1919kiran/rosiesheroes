---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBottomNav from '../components/layout/MobileBottomNav.astro';
import { impactMetrics, impactReportedAsOf } from '../data/impact';
import { rescueProjects, projectDonateUrl, traumaStoriesByMonth } from '../data/impact-page';
import IndiaMap from '../components/impact/IndiaMap.astro';

const traumaMonths = traumaStoriesByMonth.filter((tm) => tm.stories.length > 0);
---

<BaseLayout title="Our Impact | Rosie's Heroes" description="Life-changing care: trauma surgeries, spay/neuters, rescue infrastructure projects, and monthly trauma recovery stories from Rosie's Heroes.">
  <Nav />
  <main class="impact-page">

    <!-- Hero -->
    <section class="impact-hero">
      <div class="impact-hero-inner">
        <h1 class="impact-title">Our Impact</h1>
        <h2 class="impact-subtitle">Life-Changing Care</h2>
        <p class="impact-lead">
          Every dog matters. Together, we&rsquo;re helping injured dogs heal,
          preventing future suffering, and giving local rescuers the resources
          to save more lives.
        </p>
        <div class="impact-counters">
          {impactMetrics.map((m) => (
            <div class="impact-counter">
              <span class="impact-counter-number">{m.value}</span>
              <span class="impact-counter-label">{m.label}</span>
            </div>
          ))}
        </div>
        <p class="impact-asof">Impact reported as of {impactReportedAsOf}</p>
      </div>
    </section>

    <!-- Where we work -->
    <section class="impact-map">
      <div class="section-container">
        <h2 class="section-title">Where We Work</h2>
        <p class="section-lead">
          From emergency trauma care to spay/neuter programs and rescue
          infrastructure, our work spans India &mdash; with more sites on the way.
        </p>
        <IndiaMap />
      </div>
    </section>

    <!-- Trauma recovery stories -->
    <section class="impact-stories">
      <div class="section-container">
        <h2 class="section-title">Trauma Recovery Stories</h2>
        <p class="section-lead">
          Follow our trauma care cases month by month. Each monthly report shares
          the dogs we treated, their progress, and the recovery your support
          makes possible.
        </p>

        <div class="story-tabs" role="tablist" aria-label="Trauma recovery stories by month">
          {traumaMonths.map((tm, i) => (
            <button
              type="button"
              role="tab"
              class:list={['story-tab', { active: i === 0 }]}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-story-tab={i}
            >
              {tm.month}
            </button>
          ))}
        </div>

        {traumaMonths.map((tm, i) => (
          <div
            class="story-panel"
            data-story-panel={i}
            hidden={i !== 0}
          >
            <div class="stories-grid">
              {tm.stories.map((story) => (
                <article class="story-card">
                  <h3 class="story-name">{story.dogName}</h3>
                  {story.story.map((para) => (
                    <p class="story-text">{para}</p>
                  ))}
                </article>
              ))}
            </div>
            {tm.reportUrl && (
              <p class="story-report">
                <a href={tm.reportUrl} target="_blank" rel="noopener">Read the full {tm.month} report &rarr;</a>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Rescue network / projects -->
    <section class="impact-projects">
      <div class="section-container">
        <h2 class="section-title">Sustainable Community Infrastructure</h2>
        <p class="section-lead">
          We empower local communities by providing critical infrastructure so they
          can independently and sustainably rescue dogs and save more lives.
        </p>
        <div class="projects-grid">
          {rescueProjects.map((p) => (
            <article class="project-card">
              <span class="project-status">{p.status}</span>
              <h3 class="project-title">{p.title}</h3>
              <p class="project-location">{p.location}</p>
              <p class="project-impact">Impact: {p.impact}</p>
              <p class="project-desc">{p.description}</p>
              <a
                href={projectDonateUrl(p.zeffySlug)}
                target="_blank"
                rel="noopener"
                class="project-link"
              >
                Support this project &rarr;
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- International partners -->
    <section class="impact-partners">
      <div class="section-container">
        <h2 class="section-title">Our International Partners</h2>
        <p class="section-lead">
          We work alongside established rescues across India &mdash; combining
          their on-the-ground reach with your support.
        </p>
        <div class="partners-grid">
          <article class="partner-card">
            <a class="partner-link" href="https://charlies-care.com/" target="_blank" rel="noopener">
              <img class="partner-logo" src="https://static.wixstatic.com/media/a6a3e8_8463822b878b49e79cc4f6fb43984c1d~mv2.png" alt="Charlie's Animal Rescue Center (CARE) logo" loading="lazy" />
              <h3 class="partner-name">Charlie's Animal Rescue Center (CARE)</h3>
            </a>
            <p class="partner-loc">Bangalore</p>
            <p class="partner-text">
              Through CARE, we provide critical lifesaving trauma care and spay/neuter to street dogs in Bangalore and surrounding villages.
            </p>
          </article>
          <article class="partner-card">
            <a class="partner-link" href="https://peopleforanimalsindia.org/" target="_blank" rel="noopener">
              <img class="partner-logo" src="https://peopleforanimalsindia.org/img/logo.png" alt="People for Animals (PFA) logo" loading="lazy" />
              <h3 class="partner-name">People for Animals (PFA)</h3>
            </a>
            <p class="partner-loc">Pan-India</p>
            <p class="partner-text">
              With PFA, we build rescue infrastructure across India &mdash; ambulances,
              medical equipment, and ICUs that empower communities to take action.
            </p>
          </article>
          <article class="partner-card">
            <a class="partner-link" href="https://strayanimalfoundationindia.org/" target="_blank" rel="noopener">
              <img class="partner-logo" src="https://strayanimalfoundationindia.org/wp-content/uploads/2022/04/SAFI-Logo_GRY-MED-200x229.png" alt="Stray Animal Foundation of India (SAFI) logo" loading="lazy" />
              <h3 class="partner-name">Stray Animal Foundation of India (SAFI)</h3>
            </a>
            <p class="partner-loc">International Adoptions</p>
            <p class="partner-text">
              Through SAFI, we support logistics for international adoptions.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="impact-closing">
      <div class="section-container">
        <h2 class="section-title">Made possible by you</h2>
        <p class="section-lead">
          Behind every number is a dog whose life matters. Thank you for helping
          turn pain into healing and compassion into action. Every donation is
          part of the care we make possible together.
        </p>
        <a href="/#donate" class="btn-donate">Donate</a>
      </div>
    </section>

  </main>
  <Footer />
  <MobileBottomNav />
</BaseLayout>

<script>
  // Trauma Recovery Stories — month tab switching (same as landing page)
  document.querySelectorAll('[data-story-tab]').forEach(tab => {
    tab.addEventListener('click', () => {
      const idx = tab.getAttribute('data-story-tab');
      document.querySelectorAll('[data-story-tab]').forEach(t => {
        const on = t.getAttribute('data-story-tab') === idx;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      document.querySelectorAll('[data-story-panel]').forEach(panel => {
        const on = panel.getAttribute('data-story-panel') === idx;
        if (on) { panel.removeAttribute('hidden'); } else { panel.setAttribute('hidden', ''); }
      });
    });
  });
</script>

<style>
  .impact-page {
    background-color: var(--color-cream, #FFF8F1);
    min-height: calc(100vh - var(--header-height, 97px));
  }

  .section-container {
    max-width: var(--site-width, 980px);
    margin: 0 auto;
    padding: 0 40px;
  }

  .section-title {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(30px, 4.5vw, 40px);
    color: var(--color-text, #382213);
    margin: 0 0 14px;
    text-align: center;
  }

  .section-lead {
    font-family: var(--font-body, sans-serif);
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text-mid, #5B4D43);
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  /* ── Hero ── */
  .impact-hero {
    background: linear-gradient(180deg, #FFF8F1 0%, #FFEFDA 100%);
    padding: 70px 20px 60px;
    border-bottom: 1px solid #FFEDD6;
    text-align: center;
  }

  .impact-hero-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .impact-title {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(38px, 6vw, 56px);
    color: var(--color-text, #382213);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }

  .impact-subtitle {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(22px, 3.5vw, 30px);
    font-weight: 600;
    color: var(--color-gold-hover, #775F2D);
    margin: 0 0 16px;
  }

  .impact-lead {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(16px, 2.5vw, 19px);
    line-height: 1.6;
    color: var(--color-text-mid, #5B4D43);
    margin: 0 0 36px;
  }

  .impact-counters {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 16px;
  }

  .impact-counter {
    background: #FFEFDA;
    border: 1px solid #D9A05B;
    border-radius: 16px;
    padding: 22px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .impact-counter-number {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 700;
    color: var(--color-text, #382213);
    line-height: 1;
  }

  .impact-counter-label {
    font-family: var(--font-body, sans-serif);
    font-size: 13.5px;
    color: var(--color-text-mid, #5B4D43);
    line-height: 1.35;
  }

  .impact-asof {
    font-family: var(--font-body, sans-serif);
    font-size: 13px;
    font-style: italic;
    color: var(--color-text-muted, #8C756D);
    margin: 0;
  }

  /* ── Map ── */
  .impact-map {
    padding: 72px 0 8px;
  }

  .impact-map .section-lead {
    margin-bottom: 36px;
  }

  /* ── Stories ── */
  .impact-stories {
    padding: 72px 0;
  }

  .impact-stories .section-lead {
    margin-bottom: 32px;
  }

  .story-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .story-tab {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-mid);
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-pill);
    padding: 8px 20px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .story-tab:hover {
    border-color: var(--color-gold);
  }

  .story-tab.active {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-text);
  }

  .stories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .story-card {
    border: 1px solid var(--color-card-border);
    border-radius: 4px;
    background-color: var(--color-card-bg);
    padding: var(--space-6) var(--space-8);
  }

  .story-name {
    font-family: var(--font-heading);
    font-size: var(--text-card);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
    line-height: 1.2;
  }

  .story-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }

  .story-text:last-child {
    margin-bottom: 0;
  }

  .story-report {
    margin: var(--space-6) 0 0;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .story-report a {
    color: var(--color-gold-hover, #775F2D);
    text-decoration: none;
  }

  .story-report a:hover {
    text-decoration: underline;
  }

  /* ── Projects ── */
  .impact-projects {
    padding: 72px 0;
    background: #FFEFDA;
    border-top: 1px solid #FFEDD6;
    border-bottom: 1px solid #FFEDD6;
  }

  .impact-projects .section-lead {
    margin-bottom: 36px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .project-card {
    background: #FFFDFB;
    border: 1px solid #FFEDD6;
    border-radius: 16px;
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
  }

  .project-status {
    align-self: flex-start;
    font-family: var(--font-heading, sans-serif);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text, #382213);
    background: var(--color-gold, #EEBE5A);
    border-radius: 100px;
    padding: 4px 12px;
    margin-bottom: 14px;
  }

  .project-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 20px;
    color: var(--color-text, #382213);
    margin: 0 0 4px;
  }

  .project-location {
    font-family: var(--font-body, sans-serif);
    font-size: 14px;
    color: var(--color-text-muted, #8C756D);
    margin: 0 0 4px;
  }

  .project-impact {
    font-family: var(--font-heading, sans-serif);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-gold-hover, #775F2D);
    margin: 0 0 12px;
  }

  .project-desc {
    font-family: var(--font-body, sans-serif);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-text-mid, #5B4D43);
    margin: 0 0 16px;
    flex-grow: 1;
  }

  .project-link {
    font-family: var(--font-heading, sans-serif);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-gold-hover, #775F2D);
    text-decoration: none;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  /* ── Partners ── */
  .impact-partners {
    padding: 72px 0 24px;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 36px;
  }

  .partner-card {
    background: #FFFDFB;
    border: 1px solid #FFEDD6;
    border-radius: 16px;
    padding: 28px 26px;
    text-align: center;
  }

  .partner-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .partner-link:hover .partner-name {
    text-decoration: underline;
  }

  .partner-logo {
    display: block;
    height: 64px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    margin: 0 auto 16px;
  }

  .partner-name {
    font-family: var(--font-heading, sans-serif);
    font-size: 20px;
    color: var(--color-text, #382213);
    margin: 0 0 4px;
    line-height: 1.3;
  }

  .partner-loc {
    font-family: var(--font-body, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold-hover, #775F2D);
    margin: 10px 0 12px;
  }

  .partner-text {
    font-family: var(--font-body, sans-serif);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-text-mid, #5B4D43);
    margin: 0;
  }

  .partners-note {
    font-family: var(--font-body, sans-serif);
    font-size: 15px;
    color: var(--color-text-mid, #5B4D43);
    text-align: center;
    margin: 22px 0 0;
  }

  /* ── Closing ── */
  .impact-closing {
    padding: 24px 0 88px;
    text-align: center;
  }

  .impact-closing .section-lead {
    margin-bottom: 28px;
  }

  .btn-donate {
    display: inline-block;
    font-family: var(--font-heading, sans-serif);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text, #382213);
    background: var(--color-gold, #EEBE5A);
    border-radius: 100px;
    padding: 14px 44px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-donate:hover {
    background: var(--color-gold-hover, #775F2D);
    color: #FFF8F1;
  }

  @media (max-width: 860px) {
    .impact-counters {
      grid-template-columns: repeat(2, 1fr);
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .partners-grid {
      grid-template-columns: 1fr;
    }

    .section-container {
      padding: 0 20px;
    }
  }
</style>
