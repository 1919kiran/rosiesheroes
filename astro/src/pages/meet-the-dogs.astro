---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBottomNav from '../components/layout/MobileBottomNav.astro';
import { dogs, locations } from '../data/dogs';
---

<BaseLayout title="Meet the Dogs | Rosie's Heroes">
  <Nav />

  <main class="meet-the-dogs">
    <div class="page-inner">

      <div class="page-header">
        <h1 class="page-title">
          Meet the Dogs
          <svg class="heart-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="currentColor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </h1>
        <p class="page-subtitle">Each dog has a past. You can be their future!</p>
      </div>

      <div class="filter-section">
        <p class="filter-label">Find each dog by their location!</p>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="all">All</button>
          {locations.map((loc) => (
            <button class="filter-btn" data-filter={loc}>{loc}</button>
          ))}
        </div>
      </div>

      <div class="dogs-grid">
        {dogs.map((dog) => (
          <article class="dog-card" data-location={dog.location}>
            <div class="dog-card-image">
              <img
                src={dog.photos[0]}
                alt={`Photo of ${dog.name}`}
                loading="lazy"
              />
            </div>
            <div class="dog-card-body">
              <h2 class="dog-card-name">{dog.name} {dog.emoji}</h2>
              <p class="dog-card-desc">{dog.shortDesc}</p>
              <a href={`/dogs/${dog.slug}`} class="dog-card-link">
                Read More 🐾
              </a>
            </div>
          </article>
        ))}
      </div>

      <nav class="pagination" id="pagination" aria-label="Dogs pagination" hidden>
        <button class="pagination-btn pagination-arrow" id="pagination-prev" type="button" aria-label="Previous page">‹</button>
        <ul class="pagination-pages" id="pagination-pages" role="list"></ul>
        <button class="pagination-btn pagination-arrow" id="pagination-next" type="button" aria-label="Next page">›</button>
      </nav>

      <div class="dogs-empty" id="dogs-empty" hidden>
        <span class="dogs-empty-paw">🐾</span>
        <h3 class="dogs-empty-title">No adoptable dogs here yet</h3>
        <p class="dogs-empty-text">Check back later — we regularly post adoptable dogs in different locations!</p>
      </div>

      <div class="shelterluv-section" id="shelterluv-section" hidden>
        <p class="shelterluv-intro">Adoptable dogs from our partner shelter in Hyderabad:</p>
        <div id="shelterluv_wrap_1775580826"></div>
        <p class="shelterluv-credit">Powered by <a href="https://www.shelterluv.com/" target="_blank" rel="noopener">Shelterluv</a></p>
      </div>

    </div>
  </main>

  <script is:inline src="https://new.shelterluv.com/misc/shelterluv_embed.js"></script>
  <script is:inline defer>
    var sourceDomain = "https://new.shelterluv.com";
    var base_path = "";
    var GID = 41079;
    var filters = { saved_query: 4729 };
    if (typeof EmbedAvailablePets === 'function') {
      EmbedAvailablePets("shelterluv_wrap_1775580826", GID, filters, 1, sourceDomain, base_path, 2);
    }
  </script>

  <Footer />
  <MobileBottomNav />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const PAGE_SIZE = 6;

    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.dog-card'));
    const grid = document.querySelector<HTMLElement>('.dogs-grid');
    const emptyState = document.getElementById('dogs-empty');
    const shelterluvSection = document.getElementById('shelterluv-section');

    const pagination = document.getElementById('pagination');
    const pagesList = document.getElementById('pagination-pages');
    const prevBtn = document.getElementById('pagination-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('pagination-next') as HTMLButtonElement | null;

    let currentFilter = 'all';
    let currentPage = 1;

    function scrollToGridTop() {
      if (!grid) return;
      const headerOffset = 90;
      const top = grid.getBoundingClientRect().top + window.scrollY - headerOffset;
      window.scrollTo({ top, behavior: 'smooth' });
    }

    function getFilteredCards(): HTMLElement[] {
      return cards.filter(
        (c) => currentFilter === 'all' || c.getAttribute('data-location') === currentFilter,
      );
    }

    function renderPaginationControls(totalPages: number) {
      if (!pagination || !pagesList || !prevBtn || !nextBtn) return;

      pagesList.innerHTML = '';

      if (totalPages <= 1) {
        pagination.hidden = true;
        return;
      }
      pagination.hidden = false;
      for (let i = 1; i <= totalPages; i++) {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'pagination-page' + (i === currentPage ? ' active' : '');
        btn.textContent = String(i);
        btn.setAttribute('aria-label', `Go to page ${i}`);
        if (i === currentPage) btn.setAttribute('aria-current', 'page');
        btn.addEventListener('click', () => {
          if (i === currentPage) return;
          currentPage = i;
          applyView();
          scrollToGridTop();
        });
        li.appendChild(btn);
        pagesList.appendChild(li);
      }

      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage === totalPages;
    }

    function applyView() {
      const showShelterluv = currentFilter === 'Hyderabad';

      if (shelterluvSection) shelterluvSection.hidden = !showShelterluv;

      if (showShelterluv) {
        cards.forEach((c) => (c.style.display = 'none'));
        if (grid) grid.style.display = 'none';
        if (emptyState) emptyState.hidden = true;
        if (pagination) pagination.hidden = true;
        return;
      }

      const filtered = getFilteredCards();
      const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const visibleSet = new Set(filtered.slice(start, end));

      cards.forEach((c) => {
        c.style.display = visibleSet.has(c) ? '' : 'none';
      });

      if (grid) grid.style.display = filtered.length === 0 ? 'none' : '';
      if (emptyState) emptyState.hidden = filtered.length > 0;

      renderPaginationControls(totalPages);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter') || 'all';
        currentPage = 1;
        applyView();
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          applyView();
          scrollToGridTop();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const totalPages = Math.max(1, Math.ceil(getFilteredCards().length / PAGE_SIZE));
        if (currentPage < totalPages) {
          currentPage++;
          applyView();
          scrollToGridTop();
        }
      });
    }

    applyView();
  });
</script>

<style>
  .meet-the-dogs {
    background-color: var(--color-cream);
    min-height: 100vh;
    padding: var(--space-25) 0 var(--space-20);
  }

  .page-inner {
    max-width: var(--site-width);
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  /* ── Page header ──────────────────────────────────────── */
  .page-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: var(--ls-tight);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .heart-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .page-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── Filter section ───────────────────────────────────── */
  .filter-section {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .filter-label {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    margin: 0 0 var(--space-4);
    font-weight: 500;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .filter-btn {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-gold);
    background: var(--color-card-bg);
    color: var(--color-text);
    cursor: pointer;
    transition: var(--trans-btn);
  }

  .filter-btn:hover {
    background: var(--color-gold);
    color: var(--color-text);
  }

  .filter-btn.active {
    background: var(--color-gold);
    color: var(--color-text);
    font-weight: 600;
  }

  /* ── Dogs grid ────────────────────────────────────────── */
  .dogs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* ── Shelterluv embed ─────────────────────────────────── */
  .shelterluv-section {
    padding: 0;
  }

  .shelterluv-intro {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text-mid);
    margin: 0 0 var(--space-6);
    text-align: center;
  }

  .shelterluv-credit {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    margin: var(--space-8) 0 0;
    text-align: center;
  }

  .shelterluv-credit a {
    color: var(--color-text-muted);
    text-decoration: underline;
  }

  /* ── Override Shelterluv embed styles to match site theme ── */
  :global(#shelterluv_wrap_1775580826) {
    font-family: var(--font-body) !important;
    color: var(--color-text) !important;
  }

  :global(#shelterluv_wrap_1775580826 *) {
    font-family: inherit !important;
  }

  /* Filter inputs / select boxes / search */
  :global(#shelterluv_wrap_1775580826 input),
  :global(#shelterluv_wrap_1775580826 select),
  :global(#shelterluv_wrap_1775580826 button) {
    font-family: var(--font-body) !important;
    font-size: var(--text-sm) !important;
    border-radius: var(--radius-pill) !important;
    border: 1.5px solid var(--color-card-border) !important;
    background: var(--color-card-bg) !important;
    color: var(--color-text) !important;
    padding: 8px 18px !important;
    transition: var(--trans-btn) !important;
  }

  :global(#shelterluv_wrap_1775580826 input:focus),
  :global(#shelterluv_wrap_1775580826 select:focus) {
    outline: none !important;
    border-color: var(--color-gold) !important;
  }

  :global(#shelterluv_wrap_1775580826 button:hover) {
    background: var(--color-gold) !important;
    border-color: var(--color-gold) !important;
    color: var(--color-text) !important;
  }

  /* Pet cards / images */
  :global(#shelterluv_wrap_1775580826 img) {
    border-radius: 8px !important;
    border: 1px solid var(--color-card-border) !important;
    object-fit: cover !important;
    background: var(--color-card-bg) !important;
  }

  /* Pet names (typically <a> or heading under image) */
  :global(#shelterluv_wrap_1775580826 a) {
    font-family: var(--font-heading) !important;
    font-weight: 600 !important;
    color: var(--color-text) !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
  }

  :global(#shelterluv_wrap_1775580826 a:hover) {
    color: var(--color-gold) !important;
  }

  /* Pet name labels under photos */
  :global(#shelterluv_wrap_1775580826) :global(.pet_name),
  :global(#shelterluv_wrap_1775580826) :global([class*="pet_name"]),
  :global(#shelterluv_wrap_1775580826) :global([class*="name"]) {
    font-family: var(--font-heading) !important;
    font-size: var(--text-base) !important;
    font-weight: 600 !important;
    color: var(--color-text) !important;
    margin-top: 8px !important;
  }

  /* Pagination / page number controls */
  :global(#shelterluv_wrap_1775580826) :global([class*="pag"]) {
    font-family: var(--font-body) !important;
  }

  /* ── Pagination ───────────────────────────────────────── */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-12) 0 0;
  }

  .pagination[hidden] {
    display: none;
  }

  .pagination-pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pagination-btn,
  :global(.pagination-page) {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--color-text-mid);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.18s ease, color 0.18s ease;
    padding: 0;
    -webkit-appearance: none;
    appearance: none;
    outline: none;
    line-height: 1;
  }

  .pagination-btn:focus-visible,
  :global(.pagination-page:focus-visible) {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }

  :global(.pagination-page:hover),
  .pagination-btn:hover:not(:disabled) {
    background: rgba(238, 190, 90, 0.22);
    color: var(--color-text);
  }

  :global(.pagination-page.active),
  :global(.pagination-page.active:hover) {
    background: var(--color-gold);
    color: var(--color-text);
    cursor: default;
  }

  .pagination-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .pagination-arrow {
    font-size: 20px;
    line-height: 1;
  }

  /* ── Empty state ──────────────────────────────────────── */
  .dogs-empty {
    text-align: center;
    padding: var(--space-15) var(--space-5);
    background: var(--color-card-bg);
    border: 1px dashed var(--color-card-border);
    border-radius: 12px;
  }

  .dogs-empty-paw {
    font-size: 48px;
    display: block;
    margin-bottom: var(--space-3);
  }

  .dogs-empty-title {
    font-family: var(--font-heading);
    font-size: var(--text-card);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  .dogs-empty-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: var(--color-text-muted);
    margin: 0;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ── Dog card ─────────────────────────────────────────── */
  .dog-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .dog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(56, 34, 19, 0.08);
  }

  .dog-card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .dog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dog-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .dog-card-name {
    font-family: var(--font-heading);
    font-size: var(--text-card);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-2);
    line-height: var(--lh-snug);
  }

  .dog-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--lh-relaxed);
    color: var(--color-text-mid);
    margin: 0 0 var(--space-4);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dog-card-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-gold);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .dog-card-link:hover {
    color: var(--color-gold-hover);
  }

  /* ── Tablet: 2 columns ────────────────────────────────── */
  @media (max-width: 820px) {
    .meet-the-dogs {
      padding: var(--space-15) 0 var(--space-15);
    }

    .dogs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
  }

  /* ── Mobile: 1 column ─────────────────────────────────── */
  @media (max-width: 520px) {
    .meet-the-dogs {
      padding: var(--space-10) 0 var(--space-15);
    }

    .page-title {
      font-size: 28px;
    }

    .page-subtitle {
      font-size: var(--text-base);
    }

    .dogs-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .filter-buttons {
      gap: var(--space-2);
    }

    .filter-btn {
      padding: var(--space-2) var(--space-5);
      font-size: var(--text-xs);
    }
  }
</style>
