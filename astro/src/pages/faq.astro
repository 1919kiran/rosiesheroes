---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBottomNav from '../components/layout/MobileBottomNav.astro';
import { faqSections } from '../data/faq';
---

<BaseLayout title="FAQ | Rosie's Heroes" description="Frequently asked questions about Rosie's Heroes — our mission, donations, adoption, flight volunteering, partnering, and the street-dog crisis in India.">
  <Nav />
  <main class="faq-page">
    <section class="faq-hero">
      <div class="faq-hero-inner">
        <h1 class="faq-title">Frequently Asked Questions</h1>
        <p class="faq-lead">
          Everything you want to know about Rosie&rsquo;s Heroes, how we work,
          and how you can help.
        </p>
      </div>
    </section>

    <div class="faq-body">
      <!-- Table of contents -->
      <nav class="faq-toc" aria-label="FAQ topics">
        <h2 class="faq-toc-title">Topics</h2>
        <ul class="faq-toc-list">
          {faqSections.map((s) => (
            <li>
              <a href={`#${s.id}`} class="faq-toc-link">
                <span aria-hidden="true">{s.icon}</span> {s.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Q&A sections -->
      <div class="faq-sections">
        {faqSections.map((s) => (
          <section class="faq-section" id={s.id}>
            <h2 class="faq-section-title">
              <span aria-hidden="true">{s.icon}</span> {s.title}
            </h2>
            <div class="faq-items">
              {s.items.map((item) => (
                <details class="faq-item">
                  <summary class="faq-question">{item.q}</summary>
                  <div class="faq-answer">
                    {item.a.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
  <Footer />
  <MobileBottomNav />
</BaseLayout>

<style>
  .faq-page {
    background-color: var(--color-cream, #FFF8F1);
    min-height: calc(100vh - var(--header-height, 97px));
  }

  .faq-hero {
    background: linear-gradient(180deg, #FFF8F1 0%, #FFEFDA 100%);
    padding: 70px 20px 54px;
    border-bottom: 1px solid #FFEDD6;
    text-align: center;
  }

  .faq-hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-title {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(38px, 6vw, 56px);
    color: var(--color-text, #382213);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
  }

  .faq-lead {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(16px, 2.5vw, 19px);
    line-height: 1.6;
    color: var(--color-text-mid, #5B4D43);
    margin: 0;
  }

  .faq-body {
    max-width: var(--site-width, 980px);
    margin: 0 auto;
    padding: 48px 40px 80px;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    align-items: start;
  }

  /* ── Table of contents ── */
  .faq-toc {
    position: sticky;
    top: calc(var(--header-height, 97px) + 24px);
    background: #FFFDFB;
    border: 1px solid #FFEDD6;
    border-radius: 14px;
    padding: 20px;
  }

  .faq-toc-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text, #382213);
    margin: 0 0 12px;
  }

  .faq-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .faq-toc-link {
    display: block;
    font-family: var(--font-body, sans-serif);
    font-size: 14.5px;
    color: var(--color-text-mid, #5B4D43);
    text-decoration: none;
    padding: 8px 10px;
    border-radius: 8px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .faq-toc-link:hover {
    background: rgba(238, 190, 90, 0.14);
    color: var(--color-text, #382213);
  }

  /* ── Sections ── */
  .faq-section {
    margin-bottom: 40px;
    scroll-margin-top: calc(var(--header-height, 97px) + 16px);
  }

  .faq-section:last-child {
    margin-bottom: 0;
  }

  .faq-section-title {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(24px, 3.5vw, 30px);
    color: var(--color-text, #382213);
    margin: 0 0 18px;
  }

  .faq-items {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq-item {
    background: #FFFDFB;
    border: 1px solid #FFEDD6;
    border-radius: 12px;
    overflow: hidden;
  }

  .faq-item[open] {
    border-color: rgba(238, 190, 90, 0.6);
  }

  .faq-question {
    font-family: var(--font-heading, sans-serif);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text, #382213);
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    flex-shrink: 0;
    font-size: 22px;
    font-weight: 400;
    color: var(--color-gold-hover, #775F2D);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-question::after {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 20px 18px;
    font-family: var(--font-body, sans-serif);
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-mid, #5B4D43);
  }

  .faq-answer p {
    margin: 0 0 10px;
  }

  .faq-answer p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 860px) {
    .faq-body {
      grid-template-columns: 1fr;
      padding: 32px 20px 60px;
    }

    .faq-toc {
      position: static;
    }

    .faq-toc-list {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
