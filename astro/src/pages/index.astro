---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBottomNav from '../components/layout/MobileBottomNav.astro';
import Hero from '../components/sections/Hero.astro';
import WhyRosiesHeroes from '../components/sections/WhyRosiesHeroes.astro';
import Vision from '../components/sections/Vision.astro';
import Mission from '../components/sections/Mission.astro';
import ImpactPreview from '../components/sections/ImpactPreview.astro';
import GivingPower from '../components/sections/GivingPower.astro';
import Volunteer from '../components/sections/Volunteer.astro';
import HappyTails from '../components/sections/HappyTails.astro';
import Events from '../components/sections/Events.astro';
import Donate from '../components/sections/Donate.astro';
import Partner from '../components/sections/Partner.astro';
import Contact from '../components/sections/Contact.astro';
import WaveDivider from '../components/ui/WaveDivider.astro';
---
<BaseLayout>
  <Nav />
  <main>

    <Hero />

    <WhyRosiesHeroes />
    <!-- WhyRosiesHeroes (#FFF9F1) → Vision (#FFF2E3): sweep -->
    <WaveDivider shape="B" fill="#FFF2E3" bg="#FFF9F1" height={24} />

    <Vision />
    <!-- Vision (#FFF2E3) → Mission (#FFF1E3): sweep -->
    <WaveDivider shape="B" fill="#FFEFDA" bg="#FFF2E3" height={50} />

    <Mission />
    <!-- Mission (#FFF1E3) → ImpactPreview (#FFFDFB): sweep -->
    <WaveDivider shape="B" fill="#FFFDFB" bg="#FFF1E3" height={60} />

    <ImpactPreview />
    <!-- ImpactPreview (#FFFDFB) → GivingPower (#FFF8F1): sweep -->
    <WaveDivider shape="B" fill="#FFF8F1" bg="#FFFDFB" height={60} />

    <GivingPower />

    <Donate />
    <!-- Donate (#FFF5EA) → HappyTails (#FFF8F1): sweep -->
    <WaveDivider shape="B" fill="#FFF8F1" bg="#FFF5EA" height={60} />

    <HappyTails />

    <Events />

    <Volunteer />

    <Partner />
    <!-- Partner (#FFFCF9) → Contact (#FFEFDA): sweep -->
    <WaveDivider shape="B" fill="#FFEFDA" bg="#FFFCF9" height={60} />

    <Contact />

  </main>
  <Footer />
  <MobileBottomNav />
</BaseLayout>
