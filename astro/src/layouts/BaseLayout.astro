---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Home | Rosie's Heroes",
  description = "We reduce suffering at scale and create safer communities through spay/neuter and on-the-ground care for Indian street dogs."
} = Astro.props;

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐾</text></svg>" />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-KT5FS5F1D4" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-KT5FS5F1D4');
  </script>
  <!-- Zeffy popups: binds every [zeffy-form-link] element on DOMContentLoaded, so it can't be loaded lazily -->
  <script is:inline defer src="https://zeffy-scripts.s3.ca-central-1.amazonaws.com/embed-form-script.min.js"></script>
</head>
<body>
  <slot />
  <script src="/scripts/main.js" is:inline></script>
</body>
</html>
